enseTactic_09":10,"Sword2h_High_AttackUtil_03":10,"Sword2h_Rare_Attack_01":10,"Sword2h_Rare_Attack_02":10,"Sword2h_Rare_TacticAttack_12":10,"Sword2h_Rare_Tactic_11":10,"Sword2h_Rare_Util_04":10,"Sword2h_Rare_AttackUtil_03":10,"Sword2h_Hero_Attack_01":10,"Sword2h_Hero_Util_02":10,"Sword2h_High_Util_05":10},"SP":{"Spear_Normal_Attack_01":10,"Spear_Normal_Attack_02":10,"Spear_Normal_TacticAttack_12":10,"Spear_Normal_UtilDefense_06":10,"Spear_Normal_AttackUtil_03":10,"Spear_High_Attack_01":10,"Spear_High_Attack_02":10,"Spear_High_TacticAttack_12":10,"Spear_High_DefenseTactic_09":10,"Spear_High_Util_05":10,"Spear_High_Util_04":10,"Spear_Rare_Attack_01":10,"Spear_Rare_Attack_02":10,"Spear_Rare_TacticAttack_12":10,"Spear_Rare_Defense_07":10,"Spear_Rare_Util_05":10,"Spear_Rare_Util_04":10,"Spear_Rare_AttackUtil_03":10,"Spear_Hero_Attack_01":10,"Spear_High_AttackUtil_03":10}},"msl":650,"msw":{"SP":200,"SW2":200},"msc":["WM_Common_SKILL_002","WM_Common_SKILL_001","WM_Common_SKILL_008","WM_Common_SKILL_009"],"n":"Билд","calc":"eyJ2IjoyLCJuYW1lIjoi0J_"}],"desc":"<div>\n\n  <h2><mark> О билде </mark></h2>\n  <p>\n    Билд построен на нанесение <u>колосального</u> урона на масс ПВЕ (<mark>при этом наносить приличный урон Боссам</mark>).<br>\n\n<mark>Основа этого билда</mark> — это Экспертные умения: <strong>«Взымающий дракон»</strong> + пассивка: <strong>«[[skill:WP_SW2_S_StunMaster]]»</strong>\n  </p>\n\n  <p>\n    <strong><mark>P.S.</mark></strong><br>\n    Экспертные умения: «Взымающий дракон» + пассивка: «[[skill:WP_SW2_S_StunMaster]]» — хорошо работает от 3 мобов и до 6 (включительно): от 3 мобов мана из-за «[[skill:WP_SW2_S_StunMaster]]» восстанавливается больше, чем пожирает «Взымающий дракон», а если мобов будет больше 6 — урона может не хватить для зачистки Кримсона 3, так как способность «[[spec:WP_SP_S_SpearThrower|SkillSet_WP_SP_S_SpearThrower_trait_1]]» может отскакивать не по всем мобам.\n\n(っ•﹏•)っ¤=[]:::::&gt; x(x_(x_x(x_x)x_x)_x)x)\n  </p>\n\n  <h3><mark>Ротация на масс ПВЕ:</mark></h3>\n  <ol>\n    <li>[[skill:WP_SW2_S_ShieldBuff]] + [[skill:WP_SP_S_AbnormalTolerance]] — скорость атаки + шанс мощной атаки</li>\n    <li>[[skill:WP_SP_S_DashAttack]] — для ещё большей скорости атаки (особенно на боссах из-за специализации «[[spec:WP_SP_S_DashAttack|SkillSet_WP_SP_S_DashAttack_trait_1]]»)</li>\n    <li>[[spec:WP_SP_S_RapidAttack|SkillSet_WP_SP_S_RapidAttack_trait_1]] + Волны пламени (что бы выжить максимум из пассивки «[[item:spear_aa2_t1_normal_004]]»)</li>\n    <li>[[spec:WP_SP_S_SpearThrower|SkillSet_WP_SP_S_SpearThrower_trait_1]]</li>\n    <li>[[spec:WP_SP_S_CrossAttack|SkillSet_WP_SP_S_CrossAttack_trait_4]]</li>\n  </ol>\n  <p>Оставшихся добиваем:</p>\n  <ol>\n    <li>[[skill:WP_SW2_S_CounterAttack]]\\ [[spec:WP_SW2_S_MainAttack|SkillSet_WP_SW2_S_MainAttack_trait_1]] ([[skill:WP_SW2_S_MainAttack]]) \\ [[skill:WP_SW2_S_PowerAttack]]\\ [[spec:WP_SP_S_ThrustPull|SkillSet_WP_SP_S_ThrustPull_trait_1]]</li>\n  </ol>\n\n  <h3><mark>Ротация на Боссах:</mark></h3>\n  <ol>\n    <li>[[skill:WP_SW2_S_ShieldBuff]] + [[skill:WP_SP_S_AbnormalTolerance]] — скорость атаки + шанс мощной атаки</li>\n    <li>[[skill:WP_SP_S_DashAttack]] — для ещё большей скорости атаки (особенно на боссах из-за специализации «[[spec:WP_SP_S_DashAttack|SkillSet_WP_SP_S_DashAttack_trait_1]]»)</li>\n    <li>[[spec:WP_SP_S_RapidAttack|SkillSet_WP_SP_S_RapidAttack_trait_1]] + [[spec:WP_SP_S_RapidThrust|SkillSet_WP_SP_S_RapidThrust_trait_2]] (что бы выжить максимум из пассивки «[[item:spear_aa2_t1_normal_004]]»)</li>\n    <li>[[spec:WP_SP_S_CrossAttack|SkillSet_WP_SP_S_CrossAttack_trait_4]] — сбить все стаки воспламенения</li>\n    <li>[[skill:WP_SP_S_StunAttack]] — навесить дезориентацию и увеличить крит. урон следующего скила (специализация «[[spec:WP_SP_S_StunAttack|SkillSet_WP_SP_S_StunAttack_trait_3]]»)</li>\n    <li>[[skill:WP_SW2_S_PowerAttack]]+ [[skill:WP_SW2_S_CounterAttack]]</li>\n  </ol>\n\n</div>\n\n<div>\n<h2><mark>На что можно заменить шмот</mark>(более доступный вариант)</h2>\n<p>\n\n<h3>Аксесуары</h3>\nЕсли не планируете доставать хотя бы 1 предмет с <u>небулы</u>, что бы собрать сет аксесуаров \"Ключи к могуществу\", то лучше заменить на это: \n<ol>\n <li>[[item:necklace_aa_t2_upgrade_004]] ➔ [[item:necklace_aa_t2_boss_001]] \\ [[item:necklace_aa_t2_upgrade_003]]</li>\n<li>[[item:ring_aa_t2_upgrade_007]] ➔ [[item:ring_aa_t1_nomal_012]]</li>\n<li>[[item:ring_aa_t2_upgrade_008]] ➔ [[item:ring_aa_t2_boss_004]] или более доступный вариант для старта [[item:ring_aa_t3_boss_003]]</li>\n<li>[[item:bracelet_aa2_t1_normal_010]] ➔ [[item:bracelet_aa_t2_boss_003]]</li>\n<li>[[item:belt_aa_t2_upgrade_004]] ➔ [[item:belt_aa_t2_boss_002]] \\ [[item:belt_aa_t2_upgrade_002]]</li>\n</ol>\n<h3>Броня</h3>\n\n<ol>\n  <li>[[item:chest_leather_aa_t1_set_004]] ➔[[item:chest_leather_aa_t1_nomal_005]]</li>\n  <li>[[item:legs_leather_aa_t1_nomal_005]] ➔ [[item:legs_leather_aa_t1_set_004]]</li>\n</ol>\n<i><u>Комментарий к броне</u>: данная замена позволит сохранить бонусы от сета за меньшие вложения (<b><u>черчежи</u></b> перчаток и штанов карателя по доступным ценам можно купить на аукционе: на 10.07.2026 каждая шмотка стоит всего по <u>1 900</u> Люцентов)</i>\n</p>\n<p>\n<h3>Оружие</h3>\n<ol>\n  <li>[[item:sword2h_aa_t5_boss_003]] ➔ [[item:sword2h_aa_t2_raid_001]]  [[item:sword2h_aa_t2_boss_001]]\n  <li>[[item:spear_aa_t2_raid_001]] ➔ [[item:spear_aa2_t1_normal_004]]\n</li></li></ol>\n</p>\n</div>","url":"https://tl-build.ru/build/6005"}