,"heal_modifier",1],["Attack","AA","magic_critical_attack",1],["Defense","AA","melee_evasion",1]]},{"s":"ring2","id":"ring_aa_t1_nomal_003","e":9,"t":[["kCostMax",4],["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4]],"ru":[["Assist","AA","heal_modifier",1],["Attack","AA","magic_critical_attack",1],["Defense","AA","melee_evasion",1]]},{"s":"bracelet","id":"bracelet_a_t2_addoption_005","e":9,"t":[["kHpMax",4],["kSkillPowerResistance",4],["kDebuffTakenDurationModifier",4]],"ru":[["Assist","AA","skill_power_resistance",1],["Defense","AA","magic_critical_defense",1],["Attack","AA","all_double_attack",1]]},{"s":"belt","id":"belt_a_t2_addoption_005","e":9,"t":[["kHpMax",4],["kSkillPowerResistance",4],["kDebuffTakenDurationModifier",4]],"ru":[["Assist","AA","skill_power_resistance",1],["Defense","AA","magic_critical_defense",1],["Attack","AA","boss_all_double_attack",1]]}],"act":[["WP_BO_S_Detection",null,["SkillSet_WP_BO_S_Detection_trait_1","SkillSet_WP_BO_S_Detection_trait_3","SkillSet_WP_BO_S_Detection_trait_4"]],["WP_WA_GR_S_HealField",null,[]],["WP_BO_S_AttackMark",null,["SkillSet_WP_BO_S_AttackMark_Trait_2"]],["WP_BO_S_DoubleShot",null,["SkillSet_WP_BO_S_DoubleShot_Trait_1","SkillSet_WP_BO_S_DoubleShot_Trait_2"]],["WP_WA_GR_S_Decay",null,["SkillSet_WP_WA_GR_S_Decay_trait_1"]],["WP_WA_GR_S_Heal",null,["SkillSet_WP_WA_GR_S_Heal_trait_2","SkillSet_WP_WA_GR_S_Heal_trait_3"]],["WP_WA_GR_S_MagicShield",null,["SkillSet_WP_WA_GR_S_MagicShield_trait_2"]],["WP_WA_GR_S_HealAll",null,["SkillSet_WP_WA_GR_S_HealAll_trait_3","SkillSet_WP_WA_GR_S_HealAll_trait_2"]],["WP_BO_S_AbnormalDispel",null,["SkillSet_WP_BO_S_AbnormalDispel_Trait_1","SkillSet_WP_BO_S_AbnormalDispel_Trait_2","SkillSet_WP_BO_S_AbnormalDispel_Trait_3"]],["WP_WA_GR_S_DefenseUp",null,["SkillSet_WP_WA_GR_S_DefenseUp_trait_3"]],["WP_BO_S_RegenAura",null,["SkillSet_WP_BO_S_RegenAura_Trait_1"]],["WP_BO_S_RegenHeal",null,["SkillSet_WP_BO_S_RegenHeal_Trait_1"]]],"pas":[["WP_WA_GR_S_DayHealNightCurse",null,[]],["WP_WA_GR_S_CurseDuration",null,[]],["WP_WA_GR_S_HealEfficiencyByMaxCost",null,[]],["WP_WA_GR_S_HealEffectUpWhenSkillDamageTaken",null,[]],["WP_WA_GR_S_SupportAllyCostRegenUp",null,[]],["WP_BO_S_AuraDefenceUp",null,[]],["WP_BO_S_NatureForce",null,[]],["WP_BO_S_AbnormalShield",null,[]]],"def":["WP_WA_GR_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":""}],"desc":"<i><b>Предлагаемый билд подразумевает игру в кооперации с вашей второй Малышкой-Хилочкой в КП.</b></i>\n\n<hr>\n\nОсновной принцип \"работы\" такого целителя:\n\n<ul>\n  <li>Ваш ДД перманентно хочет иметь на себе 3 стака [[skill:WP_BO_S_RegenHeal]].\n<i>При разгоне <span>КДР</span> и <span>Длительности положительных эффектов</span> количество желающих иметь данные стаки увеличивается пропорционально.</i></li>\n</ul>\n\n\n<ul>\n  <li>В накал страстей используйте [[skill:WP_BO_S_RegenAura]]. Это увеличит исцеление 3ёх ваших стаков от [[skill:WP_BO_S_RegenHeal]] до невероятных масштабов.</li>\n</ul>\n\n\n<ul>\n  <li>В критические моменты переходите на отхил с помощью [[skill:WP_WA_GR_S_Heal]].</li>\n</ul>\n\n\n<ul>\n  <li>[[spec:WP_BO_S_Detection|SkillSet_WP_BO_S_Detection_trait_1]] - позволяет значительно увеличить время действия стаков от [[skill:WP_BO_S_RegenHeal]]</li>\n</ul>\n\n\n<ul>\n  <li>Грамотно используйте [[spec:WP_BO_S_DoubleShot|SkillSet_WP_BO_S_DoubleShot_Trait_1]]. Помимо рефреша последнего используемого умения, он улучшает, указанные в описании этой специализации.\n<i>Предпочитаю делать акцент на связке с </i>[[skill:WP_BO_S_AbnormalDispel]]<i> - при улучшении этого умения с помощью </i>[[spec:WP_BO_S_DoubleShot|SkillSet_WP_BO_S_DoubleShot_Trait_1]]<i>, оно снимает не один дэбаф, не два, а абсолютно все, что висят в этот момент на вашем любимом ДД.</i></li>\n</ul>\n\n<ul>\n  <li>Усиляйте своего ДД с помощью [[spec:WP_WA_GR_S_Decay|SkillSet_WP_WA_GR_S_Decay_trait_1]]. Защищайте своего ДД с помощью [[skill:WP_WA_GR_S_DefenseUp]].</li>\n</ul>\n\n<hr>\n\n<ul>\n  <li>Ваш второй целитель должен использовать [[item:bow_aa_t5_boss_002]]. Причина - пассивка Карнекса на увеличение радиуса не стакается.</li>\n</ul>\n\n<ul>\n  <li>Обязательно берём [[skill:WP_WA_GR_S_CurseDuration]]. Причина - работает на [[skill:WP_WA_GR_S_Decay]] со специализацией [[spec:WP_WA_GR_S_Decay|SkillSet_WP_WA_GR_S_Decay_trait_1]].</li>\n</ul>\n\n<ul>\n  <li>Не стоит обоим хилам брать специализацию [[spec:WP_BO_S_Detection|SkillSet_WP_BO_S_Detection_trait_3]]. Она не стакается, пускай второй хил вложит оставшиеся 5 очков в другой спэлл.</li>\n</ul>\n\n<hr>\n\n<i>p.s. данный билд рассчитан исключительно на ГвГ-геймплей. Для хрюка выбирайте другие сборки.</i>","url":"https://tl-build.ru/build/141"}