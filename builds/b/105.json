A_S_CriticalDamageUp",15,[]],["WP_DA_DA_S_MoveSkillEvasion",15,[]],["WP_SP_S_Passive_TwoHandWeaponBonus",15,[]],["WP_SP_S_Passive_MoveBuff",15,[]],["WP_SP_S_Passive_WeakenkBonus",15,[]],["WP_SP_S_Passive_LowHPAttack",15,[]],["WP_SP_S_Passive_ComboBuff",15,[]]],"def":["WP_DA_DA_S_CounterMove",15,[]],"art":[["gemstone1","gemstone_a_set_03_001",[]],["gemstone2","gemstone_a_set_03_002",[]],["talistone1","talistone_a_set_06_001",[["bonus_attack_power_main_hand",9]]],["talistone3","talistone_a_set_06_003",[["hp_max",1600]]],["talistone2","talistone_a_set_01_002",[["all_armor",160]]],["talistone4","talistone_a_set_01_004",[]]],"ms":{"SP":{"Spear_Normal_Attack_01":10,"Spear_Normal_Attack_02":10,"Spear_Normal_AttackUtil_03":10,"Spear_High_Attack_01":10,"Spear_High_Attack_02":10,"Spear_High_TacticAttack_12":10,"Spear_Rare_Attack_02":10,"Spear_Rare_Util_05":10,"Spear_Rare_AttackUtil_03":10,"Spear_Hero_Attack_01":10},"DA":{"Dagger_Normal_Attack_01":10,"Dagger_Normal_Attack_02":10,"Dagger_Normal_TacticAttack_12":10,"Dagger_High_Attack_01":10,"Dagger_High_Attack_02":10,"Dagger_High_TacticAttack_12":10,"Dagger_High_Tactic_10":10,"Dagger_Rare_Attack_01":10,"Dagger_Rare_TacticAttack_12":10,"Dagger_Rare_Tactic_11":10}},"msl":260,"msw":{"SP":100,"DA":100},"msc":["WM_Common_SKILL_001","WM_Common_SKILL_002"],"n":"Билд 3","calc":""}],"desc":"<h2>Билд против меты уклонения</h2>\n\n<h3>Экипировка</h3>\n\n\nБерём это для метскости\n[[item:spear_aa_t1_normal_003]] \n[[item:dagger_a_t2_nomal_002]] \n[[item:chest_leather_aa_t1_nomal_002]][[item:head_leather_aa_t1_nomal_002]]\nЭто берём как \"стандард\" во все билды на дд, пока что нет альтернатив\n[[item:legs_leather_aa_t1_nomal_003]][[item:feet_leather_aa_t1_nomal_003]]\nЭтим закрываем статы до 30 60 60, трейты выбраны с учётом пасивного свойства перчаток, так же забираем скорость атаки что в суме даёт 12,9% что даёт хороший буст\n[[item:hands_leather_aa_t1_nomal_001]] \nАналогов нет, как вариант этот плащи но теряем в меткости. Первый разгоняет скорость атаки что даёт возможность быстрее нанести урон, второй же на выживаемость, но так как в этом билде и так не много уклона 1100+ в дальний+магия, за счёт пасивки [[skill:WP_DA_DA_S_MoveSkillEvasion]] получаем около 1700+ после рывка.\n[[item:cloak_a_t1_nomal_001]]---&gt;[[item:cloak_a_t2_set_004]][[item:cloak_aa_t1_nomal_004]]\n\n<b>\n<h3>Бижа</h3>\n</b>\nТриподы на \"длит положительных ефектов\" по сути не нужны и вы просто будете переплачивать за то что бы свой баф на ту же меткость держать не 6 сек, а 9 при 50% \"длит полож.эфектов\" как по мне - слишком безполезно и дорого.\n[[item:necklace_aa_t1_Arena_001]] берём для меткости\n[[item:ring_aa_t1_nomal_010]][[item:ring_aa_t1_nomal_002]] - статы (возможна замена на [[item:ring_aa_t1_nomal_003]] котораое сейчас ну очень дешовое, хотя и не слишком здесь нужно)\n[[item:belt_aa_t1_nomal_003]][[item:bracelet_aa_t1_nomal_002]] - взято ради статов + пасивок (реген маны очень важен для нас, оставайтесь на линии)\n\n\n<h3><b>Итоги</b></h3>\nБилд собран под масс пвп, учитывая что большинство собирают ближнее уклоненние а вы будете безполезны если банально не попадаете по целям селф меткости 1400 + [[skill:WP_SP_S_AbnormalTolerance]] (4-ый трипод) = 1800+ меткости, что бы вы промахивались, уклон должен быть от 2500+ что в нешних реалиях собираемо, но у едениц классов. <b>*при 2500+ уклона примерно 41% мисов*</b>\nРуны в билде все выставлены на 0, что бы видеть нормальную \"статистику\" без рандомных вещей (после патча с завозом всех рун, где нужно будет их только прокачивать будет проще)\nВыживаемости по сути 0, вы играете от своих рывков и инвиза если вас поймали. Будут вопросы, задавайте в комментах","url":"https://tl-build.ru/build/105"}