04":10,"Staff_Rare_AttackUtil_03":10,"Staff_Hero_Attack_01":10,"Staff_Normal_Tactic_10":6},"DA":{"Dagger_Normal_Attack_01":10,"Dagger_Normal_Attack_02":10,"Dagger_Normal_TacticAttack_12":10,"Dagger_Normal_Tactic_11":10,"Dagger_Normal_Util_04":9,"Dagger_Normal_AttackUtil_03":10,"Dagger_High_Attack_01":10,"Dagger_High_Attack_02":10,"Dagger_High_TacticAttack_12":10,"Dagger_High_Tactic_10":10,"Dagger_High_DefenseTactic_09":10,"Dagger_High_Defense_07":10,"Dagger_High_UtilDefense_06":10,"Dagger_High_AttackUtil_03":10,"Dagger_Rare_TacticAttack_12":10,"Dagger_Rare_Tactic_11":10,"Dagger_Rare_Defense_07":10,"Dagger_Rare_AttackUtil_03":10,"Dagger_Hero_Tactic_04":10,"Dagger_Hero_Defense_03":10}},"msl":null,"msw":{"ST":200,"DA":200},"msc":["WM_Common_SKILL_001","WM_Common_SKILL_004","WM_Common_SKILL_006",null],"n":"Билд","calc":""}],"desc":"Здесь нет посоха Дайгона и бижы небулы по очевидным причинам, к ним надо безусловно стремиться. К сожалению, этот сайт нормально не показывает характеристики, восприятие должно быть 60, но сайт упорно тычет мне другую цифру. Я влил чисто в ловкость, чтобы вы понимали, что ловкость обязательна нужна под 80 для пассивки. <br>Так же ледяные иглы должны поменяться на грозовые иглы из-за пассивки в мастерке. <br><br>Умения расставлены на мой вкус, вы можете поменять под себя. Ваша основная задача играть от яда ( лучше поставить на 1) перед каждой атакой прожимать, давать залпы умений и уходить в инвиз. <br>Вы хрупкое стекло-ассасин. Дали максимум дамага - убежали. Вам не поможет эндюренс и инвага в ближнем бою, ибо вы самая сладкая цель для любого милика. Ваша задача жить против магов и по возможности блокировать арбалеты/луки благодаря дымовому мареву. <br><br>Сборка исключительно на урон через крит и частично через хеви на большом расстоянии. Можно упороться через другие предметы на увеличение радиуса атаки.","url":"https://tl-build.ru/build/5917"}