e_evasion",30],["Assist","A","weaken_accuracy",30]]},{"s":"bracelet","id":"bracelet_aa_t1_nomal_002","e":9,"t":[["kDebuffTakenDurationModifier",4],["kCostMax",4],["kCostRegen",4]],"ru":[["Assist","A","blind_accuracy",30],["Defense","A","range_double_defense",30],["Attack","A","melee_double_attack",30]]},{"s":"belt","id":"belt_b_t1_nomal_005","e":6,"t":[["kHpMax",2],["kHpRegen",2]]}],"act":[["WP_BO_S_RegenHeal",null,["SkillSet_WP_BO_S_RegenHeal_Trait_2","SkillSet_WP_BO_S_RegenHeal_Trait_3"]],["WP_WA_GR_S_Decay",null,[]],["WP_WA_GR_S_MagicShield",null,["SkillSet_WP_WA_GR_S_MagicShield_trait_1","SkillSet_WP_WA_GR_S_MagicShield_trait_2"]],["WP_WA_GR_S_HealField",null,["SkillSet_WP_WA_GR_S_HealField_trait_1","SkillSet_WP_WA_GR_S_HealField_trait_2","SkillSet_WP_WA_GR_S_HealField_trait_3"]],["WP_WA_GR_S_HealAll",null,["SkillSet_WP_WA_GR_S_HealAll_trait_2"]],["WP_BO_S_Detection",null,["SkillSet_WP_BO_S_Detection_trait_1","SkillSet_WP_BO_S_Detection_trait_4"]],["WP_BO_S_AbnormalDispel",null,["SkillSet_WP_BO_S_AbnormalDispel_Trait_2","SkillSet_WP_BO_S_AbnormalDispel_Trait_3"]],["WP_WA_GR_S_Sleep",null,[]],["WP_BO_S_DoubleShot",null,["SkillSet_WP_BO_S_DoubleShot_Trait_1"]],["WP_WA_GR_S_DefenseUp",null,["SkillSet_WP_WA_GR_S_DefenseUp_trait_2"]],["WP_BO_S_RegenAura",null,["SkillSet_WP_BO_S_RegenAura_Trait_1"]],["WP_BO_S_AttackMark",null,["SkillSet_WP_BO_S_AttackMark_Trait_2"]]],"pas":[["WP_WA_GR_S_DayHealNightCurse",null,[]],["WP_WA_GR_S_CurseAttackHeal",null,[]],["WP_WA_GR_S_HealEfficiencyByMaxCost",null,[]],["WP_WA_GR_S_HealEffectUpWhenSkillDamageTaken",null,[]],["WP_WA_GR_S_SupportAllyCostRegenUp",null,[]],["WP_BO_S_AbnormalShield",null,[]],["WP_BO_S_NatureForce",null,[]],["WP_BO_S_AuraDefenceUp",null,[]]],"def":["WP_WA_GR_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"","calc":"eyJ2IjoyLCJuYW1lIjoi0KXQuNC7LdC90L7QstC40YfQvtC6LCDQv9C10YDQstGL0LUg0YTQuNC-"}],"desc":"Как развивается мой ПВЕ хил<br><br>Немного пересмотрел умения - взял чистку и наложение с неё полевой медицины. Важно заметить, что перед массовым захилом надо дать \"ангела\", у него откат с Источником жизни одинаковый. Важная часть работы хила - давать метку. Можно дать метку, потом второе дыхание, ещё раз метку, кроме того будет усилено одно из умений из-за специализации \"Выход за пределы\". Не забывайте, что вы можете моментально почистить всю пати Милостью природы или Спасительным светом Клэя. В Т2 дебафов, которые нужно чистить, становится больше! Иногда, например на Гаштане, своевременная чистка оглушения поможет пережить смертельные механики.<br><br>Я выбрал именно этот лук, по той причине, что трейты на него гораздо дешевле, чем на лук Карникса, и ещё мне он выпал раньше (в Сумеречной крипте).<br><br>Как хилить:<br>накладываем [[skill:WP_BO_S_RegenHeal]], как только цель начинает терять хп, если цель быстро теряет ХП вешаем ещё стак и затем [[skill:WP_BO_S_RegenAura]] захиливает толпу, а тех, на ком полевая медицина - захиливает больше.<br><br>На босах даём метку [[skill:WP_BO_S_AttackMark]], потом сразу откат [[skill:WP_BO_S_DoubleShot]] и еще раз метку.<br><br>Массовый захил с помощью[[skill:WP_BO_S_Detection]][[spec:WP_BO_S_Detection|SkillSet_WP_BO_S_Detection_trait_1]], чередуем с массовыми захилами [[skill:WP_WA_GR_S_HealAll]] и [[skill:WP_WA_GR_S_HealField]]. <br><br>Если видим, что народ более менее скучковался подходим к ним, даём [[skill:WP_WA_GR_S_DefenseUp]], потом [[skill:WP_WA_GR_S_HealField]]<br><br>Перед механиками, где прилетает много урона, перед кушками или когда всё в откате, можно подстраховаться щитом [[skill:WP_WA_GR_S_MagicShield]]<br><br>Важно чистить дебафы с помощью[[skill:WP_BO_S_AbnormalDispel]], ведь оно не только снимает огонь, отравление, оглушение и т.д., но и наложит стак полевой медицины, что в совокупности с милостью природы даст хороший массовый захил. Также массово чистит [[skill:WP_WA_GR_S_HealAll]] и [[skill:WP_BO_S_RegenAura]]","url":"https://tl-build.ru/build/1349"}