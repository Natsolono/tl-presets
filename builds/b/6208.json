ay_trait_1"]],["WP_WA_GR_S_DefenseUp",15,["SkillSet_WP_WA_GR_S_DefenseUp_trait_1"]]],"pas":[["WP_ST_S_MaxManaUp",15,[]],["WP_WA_GR_S_DayHealNightCurse",15,[]],["WP_WA_GR_S_CurseAttackHeal",15,[]],["WP_ST_S_SkillPowerAmplificationBuff",15,[]],["WP_ST_S_AddProjectile",15,[]],["WP_WA_GR_S_HealEfficiencyByMaxCost",15,[]],["WP_ST_S_BurnTargetAddDamage",15,[]],["WP_WA_GR_S_CurseDuration",15,[]]],"def":["WP_WA_GR_S_CounterMove",15,[]],"art":[["talistone1","talistone_a_set_02_001",[]],["talistone2","talistone_a_set_02_002",[]],["talistone3","talistone_a_set_02_003",[]],["talistone4","talistone_a_set_02_004",[]],["gemstone1","gemstone_a_set_02_001",[]],["gemstone2","gemstone_a_set_02_002",[]]],"ms":{"ST":{"Staff_Normal_Tactic_10":10,"Staff_Normal_TacticAttack_12":10,"Staff_Normal_Attack_01":10,"Staff_Normal_Attack_02":10,"Staff_Normal_AttackUtil_03":10,"Staff_Normal_Util_05":10,"Staff_High_UtilDefense_06":10,"Staff_Rare_Util_04":10,"Staff_Rare_Util_Skill":1,"Staff_High_AttackUtil_03":10,"Staff_Rare_AttackUtil_03":10,"Staff_Normal_Attack_Skill":1,"Staff_High_Attack_01":10,"Staff_High_Attack_02":10,"Staff_High_Attack_Skill":1,"Staff_Rare_Attack_02":10,"Staff_High_TacticAttack_12":10,"Staff_Normal_Tactic_11":10,"Staff_Normal_Tac_Skill":1,"Staff_High_Tactic_11":10,"Staff_High_Tac_Skill":1,"Staff_Rare_Tactic_11":10,"Staff_Rare_Tactic_10":10,"Staff_Rare_Tac_Skill":1,"Staff_Hero_Tactic_04":10,"Staff_Hero_Attack_01":4},"WA_GR":{"Wand_Normal_AttackUtil_03":10,"Wand_Normal_TacticAttack_12":10,"Wand_Normal_Tactic_11":10,"Wand_Normal_Defense_07":10,"Wand_Normal_Defense_08":10,"Wand_Normal_Def_Skill":1,"Wand_Normal_Attack_Skill":1,"Wand_High_Util_05":10,"Wand_High_UtilDefense_06":10,"Wand_High_AttackUtil_03":10,"Wand_High_Util_Skill":1,"Wand_Rare_Util_05":10,"Wand_Rare_Util_04":10,"Wand_Rare_Util_Skill":1,"Wand_Rare_AttackUtil_03":10,"Wand_High_Attack_01":10,"Wand_High_Attack_02":10,"Wand_High_Attack_Skill":1,"Wand_Rare_Attack_01":10,"Wand_Rare_Attack_02":10,"Wand_Rare_Attack_Skill":1,"Wand_Hero_Attack_01":10,"Wand_High_TacticAttack_12":10,"Wand_Rare_TacticAttack_12":10,"Wand_High_Tactic_11":10,"Wand_High_Tactic_10":4}},"msl":390,"msw":{},"msc":["WM_Common_SKILL_002","WM_Common_SKILL_004","WM_Common_SKILL_006",null],"n":"Билд (копия)"}],"desc":"<h2>О билде</h2>\nКласс Инвокатор отлично раскрывается в Т2. Мы сможем в полной мере реализовать свой потенциал, а также прикрыть слабые места за счёт более гибкой системы прокачки скилов и характеристик.\n\nДанная сборка представляет из себя <b>универсальный</b> билд под все типы контента.\n\n\nДорожная карта развития класса, а также специализированные билды под PVP, массовый фарм, боссов и врата бесконечности уже лежат на <b><mark>Boosty</mark></b> ссылка в шапке профиля.\n\n\n<h3>Плюсы</h3>\n\n<ul>\n  <li>самодостаточность</li>\n<li>высокий урон</li>\n<li>универсальность</li>\n</ul>\n\n<h3>Минусы</h3> \n<ul>\n  <li>дорогая сборка</li>\n<li>все считают, что ты собрал кринжбилд</li>\n</ul>\n\n<h2>Оружие</h2>\n[[item:staff_a_t2_nomal_003]] — преобразует скилл [[skill:WP_ST_S_IceSpear]] в электрический и наносит доп.урон по врагам со стаками горения. Влияет на ротацию.\n[[item:wand_a_t2_nomal_001]] - даёт скилу [[skill:WP_WA_GR_S_CurseArea]] специализацию \"Проклятая топь\". Не во всём типе контента он будет полезен, но подобных универсальных доступных альтернатив нет.\n\n<h2>Броня</h2>\nСобираем набор 2+2+1 ради получения нужных эффектов от двух комплектов. \n[[item:head_leather_aa_t1_set_003]] + [[item:chest_leather_aa_t1_set_003]] повышают крит урон.\n[[item:legs_fabric_aa_t1_set_001]] + [[item:feet_fabric_aa_t1_set_001]] повышают периодический урон.\n[[item:hands_fabric_aa_t1_nomal_005]] - хорошие перчатки с нужными характеристиками.\n[[item:cloak_aa_t1_nomal_006]] - вещи с ш.мощн.атк. в приоритете.\n\nМенять данные предметы и тасовать наборы не советую - потеряете нужные статы от вещей.\nТрейты забаланшены так, чтобы всё уклонение было &gt;600.\n\n<h2>Бижа</h2>\nВыбираем предметы с нужными статами и характеристиками.\n\n<h3>В нашем случае это:</h3>\n\n<ul>\n  <li>ш.мощн.атк</li>\n  <li>скорость атаки</li>\n  <li>шанс.крит.удара</li>\n  <li>скор.восст.умений</li>\n  <li>расход маны</li>\n</ul>\n\nПодбробнее про характеристики читай в моём ТГ канале — ссылка в шапке профиля.\n\n<h2>Скилы и ротация</h2>\nНабор скилов остаётся примерно тем же, что и в Т1.\n\nРади использования пассивки из оружия для [[skill:WP_WA_GR_S_CurseArea]] слегка изменены специализации. Но это не обязательно.\n[[skill:WP_WA_GR_S_CurseBurst]] используйте со специализацией \"Сглаз\" на своё усмотрение.\nПассивки [[skill:WP_ST_S_MaxManaUp]] — [[skill:WP_WA_GR_S_CurseKillBonus]] — [[skill:WP_ST_S_ManaRegenBuff]] взаимозаменяемые в зависимости от типа контента.\n\n<h3>Ротация</h3>\n1. [[skill:WP_ST_S_GlobalCoolDownBuff]]\n2. [[skill:WP_WA_GR_S_Decay]]\n3. [[skill:WP_WA_GR_S_DefenseUp]]\n4. [[skill:WP_WA_GR_S_CurseArea]]\n5. [[skill:WP_WA_GR_S_Corruption]]\n6. [[skill:WP_ST_S_WideAreaAttack]]\n7. [[skill:WP_WA_GR_S_Corruption]]\n8. [[skill:WP_ST_S_WideAreaDebuffAttack]]\n9. [[skill:WP_ST_S_IceSpear]]\n10. [[skill:WP_WA_GR_S_CurseBurst]]\n11. Остальные скилы\n\n<h2>Заключение</h2>\nЕсли вам понравилось играть на данном билде в Т1 хрониках, то в Т2 вы ещё больше кайфанёте от того насколько сильным стал персонаж и какие результаты он будет показывать.\n\n\n<blockquote>Не забудьте оценить билд ★★★★★</blockquote>\n\nХотите узнать больше об Инвокаторе? Мои мысли по игре, разбор характеристик и скилов уже ждут вас в <b><mark>Telegram</mark></b>. \nПереходите по ссылке в шапке профиля!","url":"https://tl-build.ru/build/6208"}