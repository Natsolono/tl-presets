l,["SkillSet_WP_WA_GR_S_HealField_trait_1","SkillSet_WP_WA_GR_S_HealField_trait_2","SkillSet_WP_WA_GR_S_HealField_trait_3"]],["WP_WA_GR_S_HealAll",null,["SkillSet_WP_WA_GR_S_HealAll_trait_2"]],["WP_BO_S_RegenAura",null,["SkillSet_WP_BO_S_RegenAura_Trait_1"]],["WP_BO_S_AbnormalDispel",null,["SkillSet_WP_BO_S_AbnormalDispel_Trait_2","SkillSet_WP_BO_S_AbnormalDispel_Trait_3"]],["WP_WA_GR_S_Sleep",null,[]],["WP_BO_S_DoubleShot",null,["SkillSet_WP_BO_S_DoubleShot_Trait_1"]],["WP_WA_GR_S_DefenseUp",null,["SkillSet_WP_WA_GR_S_DefenseUp_trait_2"]],["WP_BO_S_Detection",null,["SkillSet_WP_BO_S_Detection_trait_1","SkillSet_WP_BO_S_Detection_trait_4"]],["WP_BO_S_AttackMark",null,["SkillSet_WP_BO_S_AttackMark_Trait_2"]]],"pas":[["WP_WA_GR_S_DayHealNightCurse",null,[]],["WP_WA_GR_S_CurseAttackHeal",null,[]],["WP_WA_GR_S_HealEfficiencyByMaxCost",null,[]],["WP_WA_GR_S_HealEffectUpWhenSkillDamageTaken",null,[]],["WP_WA_GR_S_SupportAllyCostRegenUp",null,[]],["WP_BO_S_AuraDefenceUp",null,[]],["WP_BO_S_NatureForce",null,[]],["WP_BO_S_AbnormalShield",null,[]]],"def":["WP_WA_GR_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"","calc":""}],"desc":"Недавно взял 50 уровень хилом, пытаюсь прийти к такому билду. Хилу нужно не менее 12К ХП, а лучше больше, реген маны, откат умелок и длительность бафов. Если не говорить о статах, которых с синего шмота много не получишь. Эти вещи получить относительно просто. Даже собрав только часть из них вы спокойно сможете хилить Т1 данжи и регионы с пактом бездны. В процессе развития, дополняя билд фиолетовыми вещами, спокойно справитесь и в Т2<br><br>Оружие можно получить из ларцов у гильдейского торговца. Благодаря гильдейским ларцам, вы быстро откроете необходимые трейты на оружии.<br><br>Сапоги и штаны и амулет в большом количестве выпадают из Святилища желаний. Шапка из бездны Силеуса, там же можно выбить фиол жезл.<br><br>Как хилить:<br>накладываем [[skill:WP_BO_S_RegenHeal]], как только цель начинает терять хп, если цель быстро теряет ХП вешаем ещё стак и затем [[skill:WP_BO_S_RegenAura]] захиливает толпу, а тех, на ком полевая медицина - захиливает больше.<br><br>На босах даём метку [[skill:WP_BO_S_AttackMark]], потом сразу откат [[skill:WP_BO_S_DoubleShot]] и еще раз метку.<br><br>Массовый захил с помощью[[skill:WP_BO_S_Detection]][[spec:WP_BO_S_Detection|SkillSet_WP_BO_S_Detection_trait_1]], чередуем с массовыми захилами [[skill:WP_WA_GR_S_HealAll]] и [[skill:WP_WA_GR_S_HealField]]. <br><br>Если видим, что народ более менее скучковался подходим к ним, даём [[skill:WP_WA_GR_S_DefenseUp]], потом [[skill:WP_WA_GR_S_HealField]]<br><br>Перед механиками, где прилетает много урона, перед кушками или когда всё в откате, можно подстраховаться щитом [[skill:WP_WA_GR_S_MagicShield]]<br><br>Важно чистить дебафы с помощью[[skill:WP_BO_S_AbnormalDispel]], ведь оно не только снимает огонь, отравление, оглушение и т.д., но и наложит стак полевой медицины, что в совокупности с милостью природы даст хороший массовый захил. Также массово чистит [[skill:WP_WA_GR_S_HealAll]] и [[skill:WP_BO_S_RegenAura]]<br>","url":"https://tl-build.ru/build/510"}