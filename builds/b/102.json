wer_resistance",80],["Defense","AA","hp_max",80],["Attack","AA","range_double_attack",80]]},{"s":"ring2","id":"ring_aa_t1_nomal_003","e":9,"t":[["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4],["kCostMax",4]],"ru":[["Assist","AA","skill_heal_taken_modifier",80],["Defense","AA","range_evasion",80],["Attack","AA","range_critical_attack",80]]},{"s":"ring1","id":"ring_aa_t1_nomal_010","e":9,"t":[["kHpMax",4],["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4]],"ru":[["Assist","AA","potion_heal_modifier",80],["Defense","AA","magic_evasion",80],["Attack","AA","range_critical_attack",80]]},{"s":"necklace","id":"necklace_aa_t1_nomal_005","e":9,"t":[["kHpMax",4],["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4]],"ru":[["Attack","AA","range_accuracy",80],["Defense","AA","range_evasion",80],["Assist","AA","skill_heal_taken_modifier",80]]}],"act":[["WP_BO_S_StrongShot",null,["SkillSet_WP_BO_S_StrongShot_Trait_3"]],["WP_BO_S_BindShot",null,[]],["WP_BO_S_PowerShot",null,["SkillSet_WP_BO_S_PowerShot_Trait_1","SkillSet_WP_BO_S_PowerShot_Trait_2"]],["WP_BO_S_MultiShot",null,["SkillSet_WP_BO_S_MultiShot_Trait_1","SkillSet_WP_BO_S_MultiShot_Trait_3"]],["WP_BO_S_RegenAura",null,[]],["WP_BO_S_AttackMark",null,[]],["WP_DA_DA_S_CriticalStrike",null,["SkillSet_WP_DA_DA_S_CriticalStrike_trait_1"]],["WP_DA_DA_S_BlinkStrike",null,["SkillSet_WP_DA_DA_S_BlinkStrike_trait_1","SkillSet_WP_DA_DA_S_BlinkStrike_trait_2"]],["WP_DA_DA_S_DeadlyStrike",null,["SkillSet_WP_DA_DA_S_DeadlyStrike_trait_1"]],["WP_DA_DA_S_PoisonEnchant",null,["SkillSet_WP_DA_DA_S_PoisonEnchant_trait_1","SkillSet_WP_DA_DA_S_PoisonEnchant_trait_3"]],["WP_DA_DA_S_SonicAttacka",null,["SkillSet_WP_DA_DA_S_SonicAttacka_trait_3"]],["WP_DA_DA_S_DelayDamage",null,["SkillSet_WP_DA_DA_S_DelayDamage_trait_3","SkillSet_WP_DA_DA_S_DelayDamage_trait_4"]]],"pas":[["WP_DA_S_MeleeAccuracy",null,[]],["WP_BO_S_WindBonusProjectile",null,[]],["WP_DA_S_CriticalDamageUp",null,[]],["WP_DA_S_PoisonTargetOffHandAttack",null,[]],["WP_BO_S_AuraDefenceUp",null,[]],["WP_BO_S_DistanceCritical",null,[]],["WP_BO_S_InplaceAttack",null,[]],["WP_BO_S_BindAccuracyBoost",null,[]]],"def":["WP_BO_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"","calc":""}],"desc":"<h2>О билде</h2>\n<p>Привет! Данный PvE-билд ориентирован на максимальное выжимание ДПС в соло и АОЕ цели за счет идеальной синергии Длинного лука и Кинжалов через механику электричества. Главная фишка — огромный урон под электро-эффектами и разгон дистанции для финальных выстрелов.</p>\n\n<h3>Основные преимущества:</h3>\n<ul>\n  <li>Колоссальный взрывной урон (Бурст) по боссам.</li>\n  <li>Полная взаимосвязь скилов: вешаем «Статический заряд» и моментально разряжаем его.</li>\n  <li>Отличная мобильность и выживаемость в Т1-Т2 данжах.</li>\n</ul>\n\n<h3>Краткая ротация для максимального ДПС:</h3>\n<p><b>1. Подготовка (Издали):</b> Знак жертвы -&gt; Опутывающая стрела -&gt; Множественный выстрел (х2 для разгона скорости атаки).</p>\n<p><b>2. Влет и Зарядка:</b> Включаем Клинки-молнии (Caps) -&gt; Удар из тени (X) за спину -&gt; Танец кинжалов (R) -&gt; Клинки полнолуния (Z).</p>\n<p><b>3. Взрыв комбо:</b> Клеймо смерти (через Грозовой фронт) -&gt; Жестокое рассечение (C) для мощнейшего финиша по электро-стакам.</p>\n<p><b>4. Отход:</b> Откатываемся назад на 20 метров -&gt; Точный выстрел (3) -&gt; Порыв ветра (1) с бонусом +140% урона за дистанцию!</p>\n\n<h3>Статы и Экипировка:</h3>\n<p>Упор делаем на Ловкость и Восприятие для разгона шанса крита и меткости, чтобы не промахиваться по боссам в Т2 контенте. Силу добираем шмотом для базовой атаки и шанса мощной атаки.</p>\n<h3>Важные фишки и советы по геймплею:</h3>\n<ul>\n  <li><b>Следите за дистанцией:</b> Финальный выстрел «Порыв ветра» наносит максимум урона именно на расстоянии 20 метров. Не ленитесь делать кувырок назад или отбегать перед завершением комбо.</li>\n  <li><b>Менеджмент маны:</b> Если в затяжных боях в данжах начинает проседать мана, прожимайте «Благословение природы» строго в паузах между вашими основными бурст-ротациями.</li>\n  <li><b>Позиционирование:</b> «Коварная тень» не только сближает с боссом, но и дает безопасное окно для прокаста кинжалов, переводя вас за спину врага. Используйте это, чтобы избегать фронтальных АОЕ-атак босса.</li>\n</ul>\n\n<hr>\n<p><i>Билд проверен в актуальном PvE-контенте и выдает стабильно высокий ДПС. Пробуйте, тестируйте на манекенах и делитесь своим мнением в комментариях! Всем удачного дропа в данжах!</i></p>","url":"https://tl-build.ru/build/102"}