t_3"]],["WP_DA_DA_S_SonicAttacka",null,["SkillSet_WP_DA_DA_S_SonicAttacka_trait_2","SkillSet_WP_DA_DA_S_SonicAttacka_trait_3"]]],"pas":[["WP_DA_S_CriticalDamageUp",null,[]],["WP_DA_S_MeleeAccuracy",null,[]],["WP_ST_S_SkillPowerAmplificationBuff",null,[]],["WP_ST_S_BurnTargetAddDamage",null,[]],["WP_DA_DA_S_MoveSkillEvasion",null,[]],["WP_DA_BA_S_KillMoveSpeed",null,[]],["WP_DA_S_EvasionBuff",null,[]],["WP_ST_S_MaxManaUp",null,[]]],"def":["WP_DA_DA_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":""}],"desc":"[[item:staff_a_t3_mythicbeast_003]][[item:dagger_a_t2_nomal_002]][[skill:WP_ST_S_WideAreaAttack]][[skill:WP_DA_DA_S_Stealth]]\n<h2>Pvp small scale(3v3/6v6)</h2>\n<h3>Плюсы</h3>\nМного уворота против дальних и магии\nУрон в основе магией\nМного шанса крита\n\n<h3>Минусы</h3>\nМало хп и ближнего уворота, от чего гс или копье вырезают нас\nМало меткости от чего по кинжалам или арбалетам не попадаем\n<h3>По спеллам</h3>\n<ol>\n  <li>Удар из тени+подсечка(сбиваем с ног)(можно отпрыгнуть обратно если цель потенциально вырежет нас, и далее накидывать магии)</li>\n  <li>Все остальные атакующие спелы не требуют завязки между собой(не забываем натягивать \"Огненные заряды\")</li>\n  <li>Сосредоточенный разум+Танец клинков или Удар из тени дают нам ~2тысячи уклонения дальнего+магического</li>\n</ol>\n\n<h3>Итого</h3>\nНаши цели все, потому как мета на данный момент, ближний уклон, но мы цель для всех(особенно ближников(когда они понимают что ближнего уклона мало))\nСтараться избегать копья или двуручного меча\n\n\n<h2>PS</h2>\nЕсть, то что я бы поменял в билде, но когда проточил все, выходит дорого\nВместо Посоха Таублека, можно взять Талуса, поможет в выживаемости против ближних станлоков, но увы с момента обт ру сервера он мне так и не достался","url":"https://tl-build.ru/build/449"}