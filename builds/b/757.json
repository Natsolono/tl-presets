_double_defense",0],["Attack","AA","melee_double_attack",0]]},{"s":"belt","id":"belt_a_t2_addoption_003","e":9,"t":[["kHpMax",4],["kDebuffTakenDurationModifier",4],["kSkillPowerResistance",4]],"ru":[["Assist","AA","stun_accuracy",0],["Defense","AA","range_double_defense",0],["Attack","AA","melee_accuracy",0]]},{"s":"weapon1","id":"bow_aa_t5_boss_001","e":9,"t":[["kAllAccuracy",4],["kAllCriticalAttack",4],["kAllDoubleAttack",4]],"ru":[["Attack","AA","buff_given_duration_modifier",0],["Assist","AA","weaken_accuracy",0],["Defense","AA","melee_evasion",0]]},{"s":"weapon2","id":"dagger_aa_t5_boss_001","e":9,"t":[["kAllAccuracy",4],["kAllCriticalAttack",4],["kAllDoubleAttack",4]],"ru":[["Attack","AA","buff_given_duration_modifier",60],["Assist","AA","weaken_accuracy",0],["Defense","A","melee_evasion",0]]}],"act":[["WP_BO_S_MultiShot",null,["SkillSet_WP_BO_S_MultiShot_Trait_3"]],["WP_BO_S_StrongShot",null,[]],["WP_BO_S_BindShot",null,["SkillSet_WP_BO_S_BindShot_Trait_3"]],["WP_BO_S_PowerShot",null,["SkillSet_WP_BO_S_PowerShot_Trait_5","SkillSet_WP_BO_S_PowerShot_Trait_4","SkillSet_WP_BO_S_PowerShot_Trait_1","SkillSet_WP_BO_S_PowerShot_Trait_2"]],["WP_BO_S_Detection",null,["SkillSet_WP_BO_S_Detection_trait_2"]],["WP_DA_DA_S_PoisonEnchant",null,[]],["WP_DA_DA_S_ShadowChaser",null,["SkillSet_WP_DA_DA_S_ShadowChaser_trait_2"]],["WP_DA_DA_S_CriticalStrike",null,["SkillSet_WP_DA_DA_S_CriticalStrike_trait_1","SkillSet_WP_DA_DA_S_CriticalStrike_trait_4","SkillSet_WP_DA_DA_S_CriticalStrike_trait_3"]],["WP_DA_DA_S_DeadlyStrike",null,["SkillSet_WP_DA_DA_S_DeadlyStrike_trait_2"]],["WP_DA_DA_S_Stealth",null,["SkillSet_WP_DA_DA_S_Stealth_trait_1","SkillSet_WP_DA_DA_S_Stealth_trait_2"]],["WP_DA_DA_S_LegAttack",null,[]],["WP_DA_DA_S_BlinkStrike",null,["SkillSet_WP_DA_DA_S_BlinkStrike_trait_2","SkillSet_WP_DA_DA_S_BlinkStrike_trait_1"]]],"pas":[["WP_DA_S_MeleeAccuracy",null,[]],["WP_DA_S_CriticalDamageUp",null,[]],["WP_BO_S_BindAccuracyBoost",null,[]],["WP_BO_S_DistanceCritical",null,[]],["WP_BO_S_WindBonusProjectile",null,[]],["WP_BO_S_AbnormalShield",null,[]],["WP_DA_DA_S_MoveSkillEvasion",null,[]],["WP_DA_S_PoisonTargetOffHandAttack",null,[]]],"def":["WP_DA_DA_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"","calc":""}],"desc":"Почему не 50 силы? Нет смысла, хеви атака будет максимум 260(это 20 процентов) и хит максимум 900-1000 что очень мало. Мы не копье и не двурук, у нас маленькие кд этим и пользуемся(нам не надо давать 2 скила на макс демедж гильотина и казнь). Больше демеджа будет от разгона критов и бонус урона. хит можно будет сделать до 1250+.<br><br>Почему не 2+2 или 4 сет? <br>Перчатки([[item:hands_leather_aa_t1_nomal_001]]) дают больше чем сет 4 собирателя жизней<br>2+2 ломают статы и хит опускается на 100+<br>Мы стеклопушка и играем от эвейжена с пасивки(окно в 6 сек когда у нас +690 эвейжена с блинка даггеров[[skill:WP_DA_DA_S_MoveSkillEvasion]]) и смысла с тушки на +4 силы и рэнж эвейжен нет[[item:chest_leather_aa_t1_nomal_001]]( лучше флат хит и декса[[item:chest_leather_aa_t1_nomal_002]]). Софт кап эвейжена уже есть.<br><br>Даггера в основном оружии на эвейжен<br>Лук в основной руке на пве<br><br>плащ можно поставить на эвагу[[item:cloak_aa_t1_nomal_004]], в угоду выживаемости. Или синий[[item:cloak_a_t1_nomal_002]] на крит/хит если еще мало точности(1200 почти за глаза, больше смысла нет)<br><br>Можно флексить торнадо флешку в масс пвп[[skill:WP_BO_S_TornadoShot]] с [[spec:WP_BO_S_TornadoShot|SkillSet_WP_BO_S_TornadoShot_Trait_1]] и [[skill:WP_BO_S_Detection]] с [[spec:WP_BO_S_Detection|SkillSet_WP_BO_S_Detection_trait_1]]<br>Обязательно тучка для масс пвп[[skill:WP_DA_DA_S_Smoke]]<br><br>На пве соло таргет меняем бинд стрелу [[skill:WP_BO_S_BindShot]]на инста кд[[skill:WP_BO_S_DoubleShot]] точного выстрела, ставим метку снайпера[[skill:WP_BO_S_AttackMark]] за место опрокида и инвиз меняем на стигму[[skill:WP_DA_DA_S_DelayDamage]] с последней специализацией<br>Не забываем про[[skill:WP_DA_DA_S_SonicAttacka]]<br><br>Почему не электро? Пойзон больше тычек/дпса в сингл таргет от духа сумрака<br><br>Ковазаны на флат урон/крит[[item:dagger_aa_t5_boss_001]](для лука тоже работает флат урон, но не пассивка дагеров), другие дагера даже рядом не стоят. <br><br>Прокасты в мили эвейжен две связки<br>3 выстрела[[skill:WP_BO_S_MultiShot]] <br>И потом[[skill:WP_BO_S_StrongShot]]<br>Второй прокст в мили эвейжн<br>[[skill:WP_BO_S_BindShot]]<br>[[skill:WP_BO_S_PowerShot]]<br><br>Флешка на ревил дагеров инвиз[[skill:WP_BO_S_Detection]]<br><br>Прокаст в ренж эвейжен <br>пойзон[[skill:WP_DA_DA_S_PoisonEnchant]], <br>дух сумрака[[skill:WP_DA_DA_S_ShadowChaser]], <br>блинк[[skill:WP_DA_DA_S_BlinkStrike]] <br>опрокид[[skill:WP_DA_DA_S_LegAttack]],<br>1нажатие[[skill:WP_DA_DA_S_CriticalStrike]],<br>Удар с [[skill:WP_DA_DA_S_PoisonEnchant]]<br>рассечение[[skill:WP_DA_DA_S_DeadlyStrike]]<br>Последнее нажатие[[skill:WP_DA_DA_S_CriticalStrike]]. <br>Ваншот 12к хп<br><br>Если бегаем пачку 6 можно ставить пассивку на эндуру и хил([[skill:WP_BO_S_AuraDefenceUp]]), добирать полевую медицину[[skill:WP_BO_S_RegenHeal]]<br><br>Сразу говорю, любой двурук - смерть если не затаймить q.","url":"https://tl-build.ru/build/757"}