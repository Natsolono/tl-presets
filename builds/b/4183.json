,90]]}],"act":[["WP_WA_GR_S_CurseBurst",15,["SkillSet_WP_WA_GR_S_CurseBurst_trait_2"]],["WP_CR_CR_S_ArmorBreakShot",15,["SkillSet_WP_CR_CR_S_ArmorBreakShot_Trait_1","SkillSet_WP_CR_CR_S_ArmorBreakShot_Trait_2"]],["WP_WA_GR_S_Corruption",15,["SkillSet_WP_WA_GR_S_Corruption_trait_2","SkillSet_WP_WA_GR_S_Corruption_trait_3","SkillSet_WP_WA_GR_S_Corruption_trait_1"]],["WP_CR_S_GhostWalk",15,["SkillSet_WP_CR_S_GhostWalk_Trait_3"]],["WP_WA_GR_S_CurseSpread",15,["SkillSet_WP_WA_GR_S_CurseSpread_trait_3","SkillSet_WP_WA_GR_S_CurseSpread_trait_2"]],["WP_CR_D_RobShot",15,[]],["WP_WA_GR_S_Decay",15,["SkillSet_WP_WA_GR_S_Decay_trait_1"]],["WP_WA_GR_S_DefenseUp",15,["SkillSet_WP_WA_GR_S_DefenseUp_trait_1","SkillSet_WP_WA_GR_S_DefenseUp_trait_3"]],["WP_CR_TauntTrap",15,["SkillSet_WP_CR_TauntTrap_Trait_1"]],["WP_WA_GR_S_LinkLaser",15,["SkillSet_WP_WA_GR_S_LinkLaser_trait_3","SkillSet_WP_WA_GR_S_LinkLaser_trait_1","SkillSet_WP_WA_GR_S_LinkLaser_trait_4"]],["WP_CR_CR_S_BloodToSoul",15,["SkillSet_WP_CR_CR_S_BloodToSoul_Trait_1"]],["WP_CR_CR_S_AddProjectile",15,["SkillSet_WP_CR_CR_S_AddProjectile_Trait_3"]]],"pas":[["WP_WA_GR_S_CurseAttackHeal",15,[]],["WP_WA_GR_S_CurseDuration",15,[]],["WP_WA_GR_S_HealEfficiencyByMaxCost",15,[]],["WP_WA_GR_S_DayHealNightCurse",15,[]],["WP_WA_GR_S_CurseKillBonus",15,[]],["WP_CR_S_WeakenAccuracy",15,[]],["WP_CR_S_AfterImage",15,[]],["WP_CR_CR_S_WeakenAttackBonus",15,[]]],"def":["WP_WA_GR_S_CounterMove",15,[]],"art":[["talistone1","talistone_a_set_02_001",[["bonus_attack_power_main_hand",9]]],["talistone2","talistone_a_set_02_002",[["all_armor",160]]],["talistone3","talistone_a_set_02_003",[["hp_max",1600]]],["talistone4","talistone_a_set_02_004",[]],["gemstone1","gemstone_a_set_02_001",[]],["gemstone2","gemstone_a_set_02_002",[]]],"ms":{"WA_GR":{"Wand_Normal_TacticAttack_12":10,"Wand_Normal_Tactic_11":10,"Wand_Normal_DefenseTactic_09":10,"Wand_Normal_Defense_08":10,"Wand_High_Attack_01":10,"Wand_High_Attack_02":10,"Wand_High_Tactic_11":10,"Wand_High_Tactic_10":10,"Wand_High_Util_05":10,"Wand_High_Util_04":10,"Wand_High_AttackUtil_03":10,"Wand_Rare_Attack_01":10,"Wand_Rare_Attack_02":10,"Wand_Rare_TacticAttack_12":10,"Wand_Rare_Tactic_11":10,"Wand_Rare_DefenseTactic_09":9,"Wand_Rare_Util_05":10,"Wand_Rare_Util_04":10,"Wand_Rare_AttackUtil_03":10,"Wand_Hero_Attack_01":10,"Wand_Normal_Tactic_10":1},"CR":{"Crossbow_Normal_Attack_01":10,"Crossbow_Normal_Attack_02":10,"Crossbow_Normal_TacticAttack_12":10,"Crossbow_Normal_Tactic_10":10,"Crossbow_Normal_Defense_08":10,"Crossbow_Normal_UtilDefense_06":10,"Crossbow_Normal_Util_05":10,"Crossbow_Normal_AttackUtil_03":10,"Crossbow_High_TacticAttack_12":10,"Crossbow_High_Tactic_11":10,"Crossbow_High_DefenseTactic_09":10,"Crossbow_High_UtilDefense_06":10,"Crossbow_Rare_Attack_02":10,"Crossbow_Rare_Tactic_11":10,"Crossbow_Rare_Util_05":10,"Crossbow_Rare_Util_04":10,"Crossbow_Rare_AttackUtil_03":10,"Crossbow_Hero_Attack_01":10,"Crossbow_Hero_Util_02":10}},"msl":650,"msw":{},"msc":["WM_Common_SKILL_002","WM_Common_SKILL_006","WM_Common_SKILL_007","WM_Common_SKILL_009"],"n":"Farm","calc":""}],"desc":"<h2>О билде</h2>\n\nЯрость — один из сильнейших классов по стабильному урону в одну цель.\n\nОсновной урон здесь наносит палочка. Арбалет выступает в роли второго оружия, которое даёт ослабления, ускоряет нанесение проклятий и усиливает основные комбинации.\n\nДанная сборка представляет из себя <b>универсальный PVE-билд с сильным уклоном в боссов</b>.\nЯрость значительно хуже чувствует себя на массовом фарме, но взамен способна выдавать очень высокий урон по одиночной цели.\n\n\n<blockquote>Носить можно как легендарный арбалет, так и палочку - зависит от того, какое оружие архибосса у вас есть в наличии. Если есть тевент - берите лег.арбалет, если нет, то палочку</blockquote>\n\n\n<h3>Плюсы</h3>\n\n<ul>\n<li>очень высокий урон по боссам</li>\n<li>сильная синергия двух оружий</li>\n<li>хороший стабильный урон в длинных боях</li>\n<li>нет серьёзных проблем с маной</li>\n</ul>\n\n<h3>Минусы</h3>\n\n<ul>\n<li>дорогая сборка</li>\n<li>требовательна к характеристикам</li>\n<li>нужно соблюдать ротацию</li>\n<li>массовый фарм заметно слабее того же Инвокатора</li>\n</ul>\n\n<h2>Оружие</h2>\n\n[[item:crossbow_aa_t2_polymorph_001]] — арбалет здесь нужен в первую очередь не ради собственного урона. Дополнительные ослабления и периодический урон хорошо сочетаются с механиками палочки и усиливают наши взрывы проклятий.\n\n[[item:wand_a_t2_nomal_001]] — основное оружие билда и главный источник урона.\n\nНесмотря на наличие арбалета, большая часть урона Ярости остаётся магической, поэтому при выборе характеристик в первую очередь ориентируемся именно на палочку.\n\n<h2>Броня</h2>\n\nСохраняем классическую схему <b>2+2+1</b>.\n\n[[item:head_leather_aa_t1_set_003]] + [[item:chest_leather_aa_t1_set_003]] закрывают первый комплект.\n\n[[item:legs_fabric_aa_t1_set_001]] + [[item:feet_fabric_aa_t1_set_001]] — второй.\n\n[[item:hands_fabric_aa_t1_nomal_005]] используем отдельным сильным предметом.\n\nТакая комбинация позволяет одновременно разгонять критический и периодический урон, не жертвуя важными характеристиками ради полного комплекта.\n\n[[item:cape_aa_t2_boss_004]] закрывает слот плаща.\n\nУходить полностью в защиту не нужно. Если персонажу не хватает выживаемости, сначала добирайте здоровье и сопротивление урону навыков через руны и дополнительные характеристики, а уже потом меняйте сами предметы.\n\n<h2>Бижа</h2>\n\nВ сборке используются:\n\n<ul>\n<li>[[item:necklace_aa2_t1_normal_011]]</li>\n<li>[[item:ring_aa_t1_nomal_013]]</li>\n<li>[[item:ring_aa_t2_boss_002]]</li>\n<li>[[item:bracelet_aa_t2_boss_003]]</li>\n<li>[[item:belt_aa_t2_boss_002]]</li>\n</ul>\n\nГлавная задача бижутерии — собрать как можно больше полезных атакующих характеристик.\n\n<h3>В приоритете:</h3>\n\n<ul>\n<li>ш.мощн.атк</li>\n<li>шанс тяжёлой магической атаки</li>\n<li>шанс магического крит.удара</li>\n<li>критический урон</li>\n<li>скор.восст.умений</li>\n<li>скорость атаки</li>\n<li>длительность усилений</li>\n<li>шанс ослабления</li>\n<li>макс.мана</li>\n<li>эффективность расхода маны</li>\n</ul>\n\nПо основным характеристикам ориентируемся на:\n\n<b>мудрость → ловкость → восприятие → сила → стойкость.</b>\n\nМудрость и ловкость стараемся разгонять максимально высоко.\n\nНе стоит при этом бесконечно набирать только одну характеристику. Ярости одновременно нужны урон, скорость атаки и скорость восстановления умений.\n\nСкорость атаки особенно важна, потому что между использованием скилов нам нужно успевать наносить обычные атаки и накладывать дополнительные эффекты.\n\nМакс.мана здесь тоже является атакующей характеристикой. В связке с [[skill:WP_WA_GR_S_HealEfficiencyByMaxCost]] она участвует в увеличении нашего урона, поэтому после достижения комфортной выживаемости мана для нас ценнее лишнего здоровья.\n\n<h2>Трейты и руны</h2>\n\n<b>На оружии приоритет примерно такой:</b>\n\n<b>скор.восст.умений → скорость атаки → длительность усилений → эффективность расхода маны → шанс тяжёлой атаки → шанс крит.удара.</b>\n\nНа броне в первую очередь интересуют скорость атаки, длительность усилений и макс.мана.\n\nНа бижутерии в приоритете ш.мощн.атк, длительность усилений, макс.мана и восстановление маны.\n\n<h2>Скилы и ротация</h2>\n\n[[skill:WP_CR_CR_S_AddProjectile]] — держим активным во время боя. Обычные атаки начинают накладывать дополнительные эффекты и становятся важной частью ротации.\n\n[[skill:WP_WA_GR_S_Decay]] — один из основных бафов на урон. Используем перед основной комбинацией.\n\n[[skill:WP_WA_GR_S_DefenseUp]] — второй баф. Используем на себя вместе с [[skill:WP_WA_GR_S_Decay]].\n\n[[skill:WP_WA_GR_S_CurseArea]] — дополнительный периодический урон. Стараемся ставить круг перед основной комбинацией с проклятиями, чтобы он успел нанести урон до взрыва и продолжил наносить его после.\n\n[[skill:WP_CR_S_GhostWalk]] — помогает реализовать большое количество накладываемых ослаблений. Используем перед основной комбинацией.\n\n[[skill:WP_WA_GR_S_Corruption]] — накладывает одно из основных проклятий.\n\n[[skill:WP_CR_CR_S_ArmorBreakShot]] — ставим непосредственно перед основным взрывом, чтобы реализовать её эффект во время бурста.\n\n[[skill:WP_WA_GR_S_CurseBurst]] — основной взрыв проклятий и одна из главных кнопок билда.\n\n[[skill:WP_WA_GR_S_CurseSpread]] используем сразу после [[skill:WP_WA_GR_S_CurseBurst]]. Со специализацией на увеличение длительности проклятий мы успеваем продлить их до фактического срабатывания взрыва и тем самым увеличить его урон.\n\nЕсли [[skill:WP_WA_GR_S_CurseSpread]] ещё не восстановился, не используем его отдельно — ждём следующего [[skill:WP_WA_GR_S_CurseBurst]] и снова прожимаем связку вместе.\n\n[[skill:WP_WA_GR_S_LinkLaser]] — дополнительный урон между основными комбинациями.\n\n[[skill:WP_CR_D_WeakPointShot]] используем под специальную атаку босса — после идеального блока навык также можно успеть применить и получить его эффект.\n\n[[skill:WP_CR_CR_S_BloodToSoul]] используем по мере восстановления для поддержания маны.\n\n<h3>Ротация</h3>\n\n[[skill:WP_CR_CR_S_AddProjectile]] активируем заранее и поддерживаем во время боя.\n\n1. [[skill:WP_WA_GR_S_Decay]]\n2. [[skill:WP_WA_GR_S_DefenseUp]]\n3. [[skill:WP_WA_GR_S_CurseArea]]\n4. [[skill:WP_CR_S_GhostWalk]]\n5. [[skill:WP_WA_GR_S_Corruption]]\n6. [[skill:WP_CR_CR_S_ArmorBreakShot]]\n7. [[skill:WP_WA_GR_S_CurseBurst]]\n8. Сразу после него — [[skill:WP_WA_GR_S_CurseSpread]]\n9. [[skill:WP_WA_GR_S_LinkLaser]]\n10. Остальные скилы и автоатаки до следующего цикла\n\nГлавная связка:\n\n<b>[[skill:WP_WA_GR_S_Corruption]] → [[skill:WP_CR_CR_S_ArmorBreakShot]] → [[skill:WP_WA_GR_S_CurseBurst]] → [[skill:WP_WA_GR_S_CurseSpread]]</b>\n\n[[skill:WP_WA_GR_S_CurseBurst]] срабатывает с небольшой задержкой. Поэтому сразу после нажатия используем [[skill:WP_WA_GR_S_CurseSpread]] и успеваем увеличить длительность проклятий до расчёта взрыва.\n\n[[skill:WP_CR_D_WeakPointShot]] в основную последовательность не входит — используем под соответствующие атаки босса.\n\n[[skill:WP_CR_CR_S_BloodToSoul]] прожимаем отдельно по мере восстановления.\n\n<h3>Пассивные навыки</h3>\n\nПассивки усиливают проклятия, повышают эффективность ослаблений, дают дополнительный урон и позволяют реализовать большое количество маны как атакующую характеристику.\n\n<h2>Заключение</h2>\n\nЯрость — класс для тех, кому хочется выжимать максимум урона из палочки по одиночной цели.\n\nСборка заметно требовательнее Инвокатора к экипировке и исполнению ротации, а на массовом фарме чувствует себя хуже. Но на боссах все эти недостатки компенсируются очень высоким стабильным уроном.\n\n<blockquote>Не забудьте оценить билд ★★★★★</blockquote>\n\nБольше разборов классов, характеристик и механик игры уже ждут вас в <b><mark>Telegram</mark></b>.\n\nСсылка в шапке профиля.<h2>О билде</h2>\n\nДанная сборка предназначена для <b>фарма мобов и прокачки мастерства оружия</b>.\n\nЯрость не лучший класс для массового фарма — Инвокатор или классы с копьём справляются с пачками заметно лучше. Поэтому воспринимайте эту сборку именно как способ комфортно качать мастерство палочки и арбалета, не меняя основной класс.\n\n<h2>Скилы и ротация</h2>\n\nОсновная механика максимально простая: накладываем проклятия на одну цель, распространяем их на всю пачку и взрываем.\n\n1. [[skill:WP_WA_GR_S_Corruption]]\n2. [[skill:WP_WA_GR_S_CurseSpread]]\n3. [[skill:WP_WA_GR_S_CurseArea]]\n4. [[skill:WP_WA_GR_S_CurseBurst]]\n\n[[skill:WP_WA_GR_S_CurseSpread]] нужен именно для распространения проклятий между противниками, после чего добиваем пачку через [[skill:WP_WA_GR_S_CurseBurst]].\n\n[[skill:WP_CR_CR_S_AddProjectile]] используем со специализацией на мороз. Это позволяет получать дополнительную скорость атаки от [Похитителя ветра].\n\n[[skill:WP_CR_TauntTrap]] используется для дополнительного контроля пачки.\n\n[[skill:WP_CR_CR_S_ArmorBreakShot]] кидаем в наиболее жирную цель перед основной комбинацией со взрывом.\n\nОстальные навыки используем по ситуации и для добивания оставшихся противников.\n\n<h2>Мастерство</h2>\n\nПри прокачке в первую очередь советую вкладываться в <b>палочку</b> примерно до 130 уровня мастерства.\n\nЧасть мастерок имеет смысл переставлять между дневным и ночным контентом ради дополнительного урона, но для обычного фарма мобов специально заморачиваться с этим не обязательно.\n\nГлавное — не пытайтесь превратить Ярость в идеальный АОЕ-класс. Сборка решает свою задачу: позволяет нормально фармить пачки и одновременно прокачивать мастерство палочки/арбалета.","url":"https://tl-build.ru/build/4183"}