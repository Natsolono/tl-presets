doption_005","e":9,"t":[["kCostMax",4],["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4]],"ru":[["Assist","AA","heal_modifier",60],["Defense","AA","cost_max",60],["Attack","AA","boss_magic_double_attack",60]]},{"s":"bracelet","id":"bracelet_aa_t1_nomal_002","e":9,"t":[["kCostMax",4],["kDebuffTakenDurationModifier",4],["kSkillPowerResistance",4]],"ru":[["Assist","AA","cost_consumption_modifier",60],["Defense","AA","cost_max",60],["Attack","AA","boss_magic_double_attack",60]]},{"s":"belt","id":"belt_a_t2_addoption_004","e":9,"t":[["kCostMax",4],["kSkillPowerResistance",4],["kDebuffTakenDurationModifier",4]],"ru":[["Assist","AA","cost_consumption_modifier",60],["Defense","AA","cost_max",60],["Attack","AA","boss_magic_double_attack",60]]},{"s":"feet","id":"feet_fabric_aa_t1_nomal_001","e":9,"t":[["kMagicEvasion",4],["kMoveSpeedModifier",4],["kHpMax",4]]}],"act":[["WP_ST_S_FireCombo",null,["SkillSet_WP_ST_S_FireCombo_trait_2"]],["WP_ST_S_WideAreaAttack",null,["SkillSet_WP_ST_S_WideAreaAttack_trait_1","SkillSet_WP_ST_S_WideAreaAttack_trait_2"]],["WP_ST_S_PowerAttack",null,["SkillSet_WP_ST_S_PowerAttack_trait_2"]],["WP_ST_S_WideAreaDebuffAttack",null,["SkillSet_WP_ST_S_WideAreaDebuffAttack_trait_3","SkillSet_WP_ST_S_WideAreaDebuffAttack_trait_2"]],["WP_ST_S_MainAttack",null,["SkillSet_WP_ST_S_MainAttack_trait_1"]],["WP_ST_S_IceSpear",null,["SkillSet_WP_ST_S_IceSpear_trait_1","SkillSet_WP_ST_S_IceSpear_trait_3"]],["WP_WA_GR_S_CurseArea",null,["SkillSet_WP_WA_GR_S_CurseArea_trait_1"]],["WP_WA_GR_S_Corruption",null,["SkillSet_WP_WA_GR_S_Corruption_trait_2","SkillSet_WP_WA_GR_S_Corruption_trait_3"]],["WP_WA_GR_S_CurseBurst",null,["SkillSet_WP_WA_GR_S_CurseBurst_trait_1","SkillSet_WP_WA_GR_S_CurseBurst_trait_3","SkillSet_WP_WA_GR_S_CurseBurst_trait_2"]],["WP_ST_S_GlobalCoolDownBuff",null,["SkillSet_WP_ST_S_GlobalCoolDownBuff_trait_2"]],["WP_WA_GR_S_Decay",null,["SkillSet_WP_WA_GR_S_Decay_trait_1"]],["WP_WA_GR_S_DefenseUp",null,["SkillSet_WP_WA_GR_S_DefenseUp_trait_1"]]],"pas":[["WP_WA_GR_S_CurseKillBonus",null,[]],["WP_WA_GR_S_DayHealNightCurse",null,[]],["WP_WA_GR_S_CurseAttackHeal",null,[]],["WP_ST_S_SkillPowerAmplificationBuff",null,[]],["WP_ST_S_AddProjectile",null,[]],["WP_WA_GR_S_HealEfficiencyByMaxCost",null,[]],["WP_ST_S_BurnTargetAddDamage",null,[]],["WP_WA_GR_S_CurseDuration",null,[]]],"def":["WP_WA_GR_S_CounterMove",null,[]],"art":[],"ms":{"WA_GR":{"Wand_Normal_Attack_01":10,"Wand_Normal_TacticAttack_12":10,"Wand_Normal_Tactic_10":10,"Wand_High_Attack_01":10,"Wand_High_Attack_02":10,"Wand_High_TacticAttack_12":10,"Wand_Rare_Util_04":10,"Wand_Rare_AttackUtil_03":10,"Wand_Hero_Attack_01":10},"ST":{"Staff_Normal_TacticAttack_12":10,"Staff_Normal_Tactic_11":10,"Staff_Normal_AttackUtil_03":10,"Staff_High_Attack_01":10,"Staff_High_Util_05":10,"Staff_High_AttackUtil_03":10,"Staff_Rare_Util_05":10,"Staff_Rare_AttackUtil_03":10,"Staff_Hero_Attack_01":10}},"msl":null,"msw":{},"msc":[],"n":"Билд","calc":""}],"desc":"<h2>О билде</h2>\nНишевый билд посох/палочка отлично подходит для освоения PVE контента. Вы сможете на изи фармить открытые данжи в соло и занимать первые места в мировых событиях и на боссах.\n\n<h3>Плюсы</h3>\n\n<ul>\n  <li>Огромный DPS</li>\n  <li>Самоотхил</li>\n  <li>Командные бафы</li>\n  <li>Простая сборка и ротация</li>\n  <li>Идентичный набор скилов под фарм и боссов</li>\n</ul>\n\n<h3>Минусы</h3>\n\n<ul>\n  <li>Жрёт много маны</li>\n  <li>Плох в PVP</li>\n  <li>Очень хочет пушку Тевента</li>\n  <li>Все считают, что ты собрал кринжбилд</li>\n</ul>\n \n\n\nБилд в Т1 не может полностью себя реализовывать по 2 причинам: \n<ul>\n  <li>нет нового дерева прокачки мастерки у оружия</li>\n  <li>нет Т2 шмота</li>\n</ul>\nС выходом нового контента можно будет разгуляться. \nНо это будет позже, а пока...\n\n<h2>Сборка и приоритет статов</h2>\n\nЛовкость -&gt; Мудрость -&gt; Восприятие -&gt; Сила\nНа старте берём 30 силы ради макс ХП, иначе будут шотать некоторые боссы.\nПотом перераспределяем статы по мере одевания.\n\n<h3>Оружие</h3>\n[[item:wand_aa_t5_boss_001]] и [[item:staff_a_t3_mythicbeast_003]] - база.\nПомним, что мы играем в PVE, поэтому берём крит, мощн.атаку и спец бафы - длит.пол.эфф. и ск.воссст. умений.\n\n<h3>Броня</h3>\nБерём по классике 2+2 \"Смерть\" и \"Мать природа\".\n\n<ul>\n  <li>По умолчанию у вас должны быть 2 шмотки [[item:head_leather_aa_t1_nomal_004]] и [[item:chest_fabric_aa_t1_nomal_001]] - это база</li>\n  <li>Альтернативный набор остальных вещей может быть таким -[[item:hands_fabric_aa_t1_nomal_001]][[item:feet_leather_aa_t1_nomal_003]][[item:legs_fabric_aa_t1_nomal_001]]. </li>\n</ul>\nЯ собрал сет, как в билде, тк мне выпало несколько [[item:hands_leather_aa_t1_nomal_003]] и я готов потерпеть до Т2 с ними, но думаю, что лучшим вариантом будут перчи со скоростью атаки из сета природы. \n\nПлащик берём [[item:cloak_aa_t1_nomal_003]].\n\n<h3>Бижа</h3>\nВ билде выбрана бижа максимально подходящая для PVE по возможности без мусорных статов. [[item:ring_aa_t3_boss_002]] - при наличии скорости атаки в руках можно заменить на кольцо со статами - смотрите сами чего не хватает.\n\n<h3>Трейты</h3>\nВ доп статах ищем:\n\n<ul>\n  <li>Шанс мощн.атаки (магия/боссы)</li>\n  <li>Шанс крит удара</li>\n  <li>Повышения/сопротивления урона умений</li>\n  <li>Макс мана</li>\n  <li>Эффективность расхода маны</li>\n  <li>Восстановлени маны</li>\n  <li>Длительность положительных эффектов</li>\n  <li>Скорость отката скилов</li>\n  <li>Скорость атаки/бега</li>\n  <li>Длительность негативных эффектов</li>\n  <li>Маг. уклон</li>\n</ul>\n\n<b>Почему так?</b>\nИдея билда на проклятия заключается в быстрой ротации наложения и подрыва проклятий. Поэтому нужна большая скорость атаки и восст.умений.\nНО! сам билд <b>ОЧЕНЬ</b> затратный по мане. Наша задача - разогнать восстановление маны до стадии, когда мы сможем отказаться от [[skill:WP_ST_S_ManaRengeUp]] и взять вместо него бафы. Плюс манареген даёт доп.урон с пассивки [[skill:WP_ST_S_AddProjectile]]. Далее берём урон умений, скорость атаки и восст.умений и длит.бафов.\n\nОднако, если у вас сейчас не будет скорости атаки в перчатках - это не супер критично - скорость восстановления умений не разгонится до значений, чтобы это сильно влияло на DPS.\n\n\n<h2>Активные Умения</h2>\nБудем разбирать в порядке приоритета в ротации.\n\n<h3>Бафы</h3>\n[[skill:WP_ST_S_GlobalCoolDownBuff]] - сильно уменьшает откат всех последующих умений, жмакаем первым\n[[skill:WP_WA_GR_S_Decay]] - крайне мощный самобаф на урон, берём всегда\n[[skill:WP_ST_S_ManaRengeUp]] - встаёт 3м в списке бафов на боссах; юзаем в начале боя даже если у вас фул мана, тк он бафает эффективность расхода маны\n[[skill:WP_WA_GR_S_DefenseUp]] и [[skill:WP_WA_GR_S_HealAll]] - берём вместо [[skill:WP_ST_S_ManaRengeUp]], если вы уже подсобрали восстанову МП. Первый для самобафа, второй для группы - выбираем, что нужно в данный момент.\n\n<h3>Проклятия</h3>\n[[skill:WP_WA_GR_S_CurseArea]] и [[skill:WP_WA_GR_S_Corruption]] - вешает проклятия на мобов. Обратите внимание, что <b>самоотхил не работает</b> без проклятий.\n[[skill:WP_WA_GR_S_CurseBurst]] - взрывает все дот эффекты - проклятия и горение. Есть 2 варианта подрыва - со снятием проклятий и без.\n\n<h3>Мощные огненные умения</h3>\n[[skill:WP_ST_S_WideAreaAttack]] - если не хотим париться, всегда юзаем огненный шар; на фарме включаем масс урон.\n[[skill:WP_ST_S_FireCombo]] - хороший урон в соло цель.\n\n<h3>Затычки</h3>\nВсё остальное наваливаем по КД, когда предыдущие скилы ушли в откат. Для фарма ставите в молниевые скилы масс урон.\n\n\n<h2>Заключение</h2>\nБилд мощный и кайфовый. В прайме может танчить боссов.\nОднако большим минусом будет слабая реализация в PVP, поэтому потребуется качать ещё 1 оружие - кинжалы/арбу/снс/лук или типа того.","url":"https://tl-build.ru/build/85"}