rmal_000","e":9,"t":[["kAllAccuracy",4],["kAllDoubleAttack",4],["kAllCriticalAttack",4]],"ru":[["Attack","AA","buff_given_duration_modifier",60],["Defense","AA","melee_evasion",60],["Assist","AA","weaken_accuracy",60]]},{"s":"chest","id":"chest_fabric_aa_t1_nomal_001","e":9,"t":[["kMagicEvasion",4],["kMeleeEvasion",4],["kBuffGivenDurationModifier",4]]},{"s":"feet","id":"feet_leather_aa_t1_nomal_003","e":9,"t":[["kRangeEvasion",4],["kMagicEvasion",4],["kMoveSpeedModifier",4]]},{"s":"legs","id":"legs_plate_aa_t1_nomal_004","e":9,"t":[["kMeleeEvasion",4],["kRangeEvasion",4],["kHpMax",4]]},{"s":"head","id":"head_leather_aa_t1_nomal_004","e":9,"t":[["kRangeEvasion",4],["kMagicEvasion",4],["kSkillCooldownModifier",4]]},{"s":"hands","id":"hands_plate_aa_t1_nomal_004","e":9,"t":[["kMeleeEvasion",4],["kRangeEvasion",4],["kAttackSpeedModifier",4]]},{"s":"cloak","id":"cloak_aa_t1_nomal_003","e":9,"t":[["kSkillPowerResistance",4],["kDebuffTakenDurationModifier",4],["kCostMax",4]]},{"s":"necklace","id":"necklace_aa_t1_nomal_005","e":9,"t":[["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4],["kHpMax",4]],"ru":[["Attack","AA","melee_accuracy",60],["Assist","AA","petrification_accuracy",60],["Defense","AA","range_evasion",60]]},{"s":"ring1","id":"ring_aa_t1_nomal_009","e":9,"t":[["kHpMax",4],["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4]],"ru":[["Attack","AA","melee_critical_attack",60],["Defense","AA","range_evasion",60],["Assist","AA","weaken_accuracy",60]]},{"s":"ring2","id":"ring_aa_t1_nomal_002","e":9,"t":[["kSkillPowerAmplification",4],["kCostMax",4],["kBuffGivenDurationModifier",4]],"ru":[["Attack","AA","melee_critical_attack",60],["Defense","AA","range_evasion",60],["Assist","AA","weaken_accuracy",60]]},{"s":"bracelet","id":"bracelet_aa_t1_nomal_004","e":9,"t":[["kHpMax",4],["kSkillPowerResistance",4],["kDebuffTakenDurationModifier",4]],"ru":[["Attack","AA","melee_double_attack",60],["Assist","AA","blind_accuracy",60],["Defense","AA","range_double_defense",60]]},{"s":"belt","id":"belt_aa_t1_nomal_003","e":9,"t":[["kCostMax",4],["kSkillPowerResistance",4],["kDebuffTakenDurationModifier",4]],"ru":[["Defense","AA","range_double_defense",60],["Attack","AA","melee_accuracy",60],["Assist","AA","stun_accuracy",60]]}],"act":[],"pas":[],"def":null,"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"Билд 7"}],"desc":"<h2>Комфортный дешевый билд на весь текущий контент</h2>\n\n<hr>\n\nСкилы на бездну/данжи указаны выше\n<hr>\n\n<h2>Раскладка на боссов с комментариями▾</h2>\n<h3>Раскладка на боссов:</h3>\n\n1. [[skill:WP_SW_SH_S_DebuffAttack]][[spec:WP_SW_SH_S_DebuffAttack|SkillSet_WP_SW_SH_S_DebuffAttack_trait_2]]\n2. [[skill:WP_SW2_S_MainAttack]][[spec:WP_SW2_S_MainAttack|SkillSet_WP_SW2_S_MainAttack_trait_1]][[spec:WP_SW2_S_MainAttack|SkillSet_WP_SW2_S_MainAttack_trait_3]]\n3. [[skill:WP_SW2_S_StunAttack]][[spec:WP_SW2_S_StunAttack|SkillSet_WP_SW2_S_StunAttack_trait_1]][[spec:WP_SW2_S_StunAttack|SkillSet_WP_SW2_S_StunAttack_trait_2]][[spec:WP_SW2_S_StunAttack|SkillSet_WP_SW2_S_StunAttack_trait_3]]\n4. [[skill:WP_SW2_S_DefenseDebuffAttack]][[spec:WP_SW2_S_DefenseDebuffAttack|SkillSet_WP_SW2_S_DefenseDebuffAttack_trait_1]][[spec:WP_SW2_S_DefenseDebuffAttack|SkillSet_WP_SW2_S_DefenseDebuffAttack_trait_3]]\n5. [[skill:WP_SW_SH_S_TauntBuff]][[spec:WP_SW_SH_S_TauntBuff|SkillSet_WP_SW_SH_S_TauntBuff_trait_1]][[spec:WP_SW_SH_S_TauntBuff|SkillSet_WP_SW_SH_S_TauntBuff_trait_3]]\n6. [[skill:WP_SW2_S_PowerAttack]][[spec:WP_SW2_S_PowerAttack|SkillSet_WP_SW2_S_PowerAttack_trait_1]][[spec:WP_SW2_S_PowerAttack|SkillSet_WP_SW2_S_PowerAttack_trait_2]]\n7. [[skill:WP_SW2_S_DamageReceive]][[spec:WP_SW2_S_DamageReceive|SkillSet_WP_SW2_S_DamageReceive_trait_1]][[spec:WP_SW2_S_DamageReceive|SkillSet_WP_SW2_S_DamageReceive_trait_2]][[spec:WP_SW2_S_DamageReceive|SkillSet_WP_SW2_S_DamageReceive_trait_3]][[spec:WP_SW2_S_DamageReceive|SkillSet_WP_SW2_S_DamageReceive_trait_4]][[spec:WP_SW2_S_DamageReceive|SkillSet_WP_SW2_S_DamageReceive_trait_5]]\n8. [[skill:WP_SW_SH_S_ShieldBuff]][[spec:WP_SW_SH_S_ShieldBuff|SkillSet_WP_SW_SH_S_ShieldBuff_trait_1]][[spec:WP_SW_SH_S_ShieldBuff|SkillSet_WP_SW_SH_S_ShieldBuff_trait_4]]\n9. [[skill:WP_SW2_S_ShieldBuff]][[spec:WP_SW2_S_ShieldBuff|SkillSet_WP_SW2_S_ShieldBuff_trait_3]]\n10. [[skill:WP_SW2_S_DashAttack]]\n11. [[skill:WP_SW_SH_S_BuffAttack]]\n12. [[skill:WP_SW_SH_S_PullSkill]][[spec:WP_SW_SH_S_PullSkill|SkillSet_WP_SW_SH_S_PullSkill_trait_2]][[spec:WP_SW_SH_S_PullSkill|SkillSet_WP_SW_SH_S_PullSkill_trait_4]]\n\n\n<h3><i>Комментарии:</i></h3>\nВсе еще не разобрался, как работает система агра в игре, никакой толковой информации все еще нет. Так что начинайте со связки [[skill:WP_SW_SH_S_DebuffAttack]] и [[skill:WP_SW2_S_MainAttack]], спамьте их по откату, так как они удерживают тот агр, который вы уже набили. \n[[skill:WP_SW2_S_StunAttack]] так же повышает текущий агр на N-ое количество, если вы уже выбили [[item:sword2h_aa_t5_boss_001]], не спамьте, жмите только в связке для [[skill:WP_SW2_S_PowerAttack]]. Если Адентуса пока нет - можно спамить, время от времени нажимая под Гильотину. \n\n[[skill:WP_SW2_S_DefenseDebuffAttack]] и [[skill:WP_SW_SH_S_PullSkill]] повышают агр до максимума, то есть переагривают босса на вас в любом случае. Это удобно, когда ГС не очень высокий и личного урона удерживать босса на себе не хватает. Не спамьте их! Держите для ситуаций срыва агра с вас.\n\n[[skill:WP_SW2_S_PowerAttack]] - сильнейший и единственный дамаг-спелл в раскладке. Перед его кастом лучше нажать [[skill:WP_SW_SH_S_TauntBuff]] и [[skill:WP_SW2_S_DefenseDebuffAttack]] для снижения брони босса и  [[skill:WP_SW2_S_StunAttack]] для повышения урона умений. С [[item:sword2h_aa_t1_nomal_001]] должно вылетать с Гильотины 9-10к, с Адентусом 20-23к (не считая хеви атаку). \n\n<hr>\n\nНа <b><i>Калагрисе </i></b>убираем первый спек на [[skill:WP_SW_SH_S_ShieldBuff]], нажимаем на механике с красными кругами. На птичках впитывайте с помощью [[skill:WP_SW_SH_S_BuffAttack]].\n\n<hr>\n\n\n<blockquote><i><i><b>\"Одержать сто побед в ста битвах — это не вершина воинского искусства. Нажать нитку вовремя и не лопнуть — вот вершина\"</b></i></i>\n— Сунь Цзы, \"Искусство войны. Том 1\", VI-V вв. до н. э\n</blockquote>\n\n\n<h2>Раскладка на бездну/данжи с комментариями▾</h2>\n\n<h3>Раскладка на мобов:</h3>\n\n1. [[skill:WP_SW_SH_S_DebuffAttack]][[spec:WP_SW_SH_S_DebuffAttack|SkillSet_WP_SW_SH_S_DebuffAttack_trait_1]][[spec:WP_SW_SH_S_DebuffAttack|SkillSet_WP_SW_SH_S_DebuffAttack_trait_2]]\n2. [[skill:WP_SW_SH_S_PullSkill]][[spec:WP_SW_SH_S_PullSkill|SkillSet_WP_SW_SH_S_PullSkill_trait_1]][[spec:WP_SW_SH_S_PullSkill|SkillSet_WP_SW_SH_S_PullSkill_trait_2]]\n3. [[skill:WP_SW2_S_DamageReceive]][[spec:WP_SW2_S_DamageReceive|SkillSet_WP_SW2_S_DamageReceive_trait_1]][[spec:WP_SW2_S_DamageReceive|SkillSet_WP_SW2_S_DamageReceive_trait_2]][[spec:WP_SW2_S_DamageReceive|SkillSet_WP_SW2_S_DamageReceive_trait_3]][[spec:WP_SW2_S_DamageReceive|SkillSet_WP_SW2_S_DamageReceive_trait_5]]\n4. [[skill:WP_SW2_S_ShieldBuff]][[spec:WP_SW2_S_ShieldBuff|SkillSet_WP_SW2_S_ShieldBuff_trait_3]]\n5. [[skill:WP_SW2_S_MainAttack]][[spec:WP_SW2_S_MainAttack|SkillSet_WP_SW2_S_MainAttack_trait_1]][[spec:WP_SW2_S_MainAttack|SkillSet_WP_SW2_S_MainAttack_trait_3]]\n6. [[skill:WP_SW2_S_DefenseDebuffAttack]][[spec:WP_SW2_S_DefenseDebuffAttack|SkillSet_WP_SW2_S_DefenseDebuffAttack_trait_1]][[spec:WP_SW2_S_DefenseDebuffAttack|SkillSet_WP_SW2_S_DefenseDebuffAttack_trait_3]]\n7. [[skill:WP_SW_SH_S_ShieldBuff]][[spec:WP_SW_SH_S_ShieldBuff|SkillSet_WP_SW_SH_S_ShieldBuff_trait_1]][[spec:WP_SW_SH_S_ShieldBuff|SkillSet_WP_SW_SH_S_ShieldBuff_trait_4]]\n8. [[skill:WP_SW_SH_S_TauntBuff]][[spec:WP_SW_SH_S_TauntBuff|SkillSet_WP_SW_SH_S_TauntBuff_trait_1]][[spec:WP_SW_SH_S_TauntBuff|SkillSet_WP_SW_SH_S_TauntBuff_trait_3]]\n9. [[skill:WP_SW2_S_LeapAttack]][[spec:WP_SW2_S_LeapAttack|SkillSet_WP_SW2_S_LeapAttack_trait_1]]\n10. [[skill:WP_SW_SH_S_ShieldThrow]][[spec:WP_SW_SH_S_ShieldThrow|SkillSet_WP_SW_SH_S_ShieldThrow_trait_1]][[spec:WP_SW_SH_S_ShieldThrow|SkillSet_WP_SW_SH_S_ShieldThrow_trait_2]]\n11. [[skill:WP_SW2_S_DashAttack]]\n12. [[skill:WP_SW_SH_S_DashAttack]]\n\n\n<h3>Комментарии: </h3>\nМобов старайтесть собирать LoS-методом (от англ. Line of Sight — «линия видимости») — после агра мобов вставайте за углы/колонны. Подводите миликов к ренжам, подтягивайте ренжей с помощью [[skill:WP_SW_SH_S_PullSkill]], после даете [[skill:WP_SW2_S_LeapAttack]], [[skill:WP_SW2_S_DamageReceive]] + [[skill:WP_SW_SH_S_ShieldBuff]], чтобы дать бафф своим ДД, после можно толкнуть в стену с помощью [[skill:WP_SW_SH_S_DashAttack]]. \n\n<hr>\n\nМобы так или иначе будут разбегаться, так что старайтесь стянуть в первой стяжке как можно больше. Чем меньше мобов останется вне первой стяжки - тем больше вы в итоге потеряете, так как таких мобов проще скипнуть, чем добивать. При необходимости кидайте [[skill:WP_SW_SH_S_ShieldThrow]], чтобы переагрить мобов, которые идут в поезде за вами. Не забывайте о [[skill:WP_SW2_S_DefenseDebuffAttack]] и [[skill:WP_SW_SH_S_TauntBuff]], они слишком сильно режут броню мобов, чтобы этим не пользоваться. \n\n\n<blockquote>\n\"<b>Так как Земля круглая, мы не отступаем, мы обходим противника с тыла</b>\"\n— Сунь Цзы, \"Искусство войны. Том 2\", VI-V вв. до н. э\n</blockquote>\n\n\n<hr>\n\n\n<h3><i>Подписывайтесь на нашу группу Вконтакте и присоединяйтесь к гильдии <b><i><u>Bliss </u></i></b>в Discord!</i></h3>\n\n\n<b>Вконтакте:</b> https://vk.ru/tlbliss\n<b>Discord:</b> https://discord.gg/B38KsQDdzn","url":"https://tl-build.ru/build/2685"}