WP_BO_S_StrongShot_Trait_1"]],["WP_ST_S_GlobalCoolDownBuff",15,["SkillSet_WP_ST_S_GlobalCoolDownBuff_trait_2","SkillSet_WP_ST_S_GlobalCoolDownBuff_trait_3"]],["WP_BO_S_RegenAura",15,["SkillSet_WP_BO_S_RegenAura_Trait_1"]],["WP_ST_S_ManaRengeUp",15,[]],["WP_BO_S_BindShot",15,["SkillSet_WP_BO_S_BindShot_Trait_2"]],["WP_ST_S_IceFreeze",15,["SkillSet_WP_ST_S_IceFreeze_trait_2"]]],"pas":[["WP_BO_S_AbnormalShield",15,[]],["WP_BO_S_BindAccuracyBoost",15,[]],["WP_ST_S_SlowDuration",15,[]],["WP_ST_S_BurnTargetAddDamage",15,[]],["WP_ST_S_MaxManaUp",15,[]],["WP_ST_S_SkillPowerAmplificationBuff",15,[]],["WP_BO_S_AuraDefenceUp",15,[]],["WP_BO_S_DistanceCritical",15,[]]],"def":["WP_ST_S_CounterMove",15,[]],"art":[["talistone1","talistone_a_set_03_001",[["bonus_attack_power_main_hand",9]]],["talistone2","talistone_a_set_08_002",[["all_armor",160]]],["talistone3","talistone_a_set_05_003",[["hp_max",1600]]],["talistone4","talistone_a_set_08_004",[["hp_max",1600]]],["gemstone1","gemstone_a_set_05_001",[["bind_accuracy",2400]]],["gemstone2","gemstone_a_set_03_002",[["all_state_tolerance",1600]]]],"ms":{"ST":{"Staff_Normal_Attack_01":10,"Staff_Normal_Attack_02":10,"Staff_Normal_TacticAttack_12":10,"Staff_Normal_DefenseTactic_09":10,"Staff_Normal_AttackUtil_03":10,"Staff_High_Attack_01":10,"Staff_High_Attack_02":10,"Staff_High_TacticAttack_12":10,"Staff_High_UtilDefense_06":10,"Staff_High_AttackUtil_03":10,"Staff_Rare_Attack_01":10,"Staff_Rare_Attack_02":10,"Staff_Rare_TacticAttack_12":10,"Staff_Rare_Tactic_10":10,"Staff_Rare_Defense_08":10,"Staff_Rare_Util_04":10,"Staff_Rare_AttackUtil_03":10,"Staff_Hero_Attack_01":10,"Staff_Hero_Defense_03":10,"Staff_Rare_Util_05":10},"BO":{"Bow_Normal_Attack_01":10,"Bow_Normal_Attack_02":10,"Bow_Normal_Tactic_10":10,"Bow_Normal_Defense_07":10,"Bow_Normal_UtilDefense_06":10,"Bow_Normal_AttackUtil_03":9,"Bow_High_Attack_02":10,"Bow_High_TacticAttack_12":10,"Bow_High_DefenseTactic_09":10,"Bow_High_Defense_07":10,"Bow_High_UtilDefense_06":9,"Bow_High_Util_04":2,"Bow_High_AttackUtil_03":10,"Bow_Rare_Attack_01":10,"Bow_Rare_Attack_02":10,"Bow_Rare_TacticAttack_12":10,"Bow_Rare_DefenseTactic_09":10,"Bow_Rare_Defense_08":10,"Bow_Rare_Util_04":10,"Bow_Hero_Attack_01":10,"Bow_Hero_Defense_03":10}},"msl":520,"msw":{"ST":200,"BO":200},"msc":["WM_Common_SKILL_001","WM_Common_SKILL_002","WM_Common_SKILL_008","WM_Common_SKILL_007"],"n":"PvP бюджет","calc":"eyJ2IjoyLCJuYW1lIjoi0JvRg9C6ICsg0L_QvtGB0L7RhTogUHZQLCDQsdGO0LTQttC10YLQvdCw0Y8g0L_RgNC-"}],"desc":"<h2>Лук + посох: переходный PvP-билд без архибоссов</h2>\n<p>Расчётный вариант для RU-серверов Astrum Play, 55 уровня и развития персонажа примерно с 5800 ГС. Основной сценарий — арена и небольшие групповые стычки. Акцент: меткость, запас здоровья, устойчивость и самостоятельное восстановление. Основа адаптации — Staff/Bow PVP от eclipso (билд 6696); при выборе умений также рассмотрены PvP-варианты Iorvund (2416). Изменены оружие, две части брони, руны, артефакты и панель умений. Это расчёт конструктора, испытания в игре не проводились.</p>\n<h3>Что означает бюджет</h3>\n<p>Без обязательных Тевента, Белландира, Дайгона и Делуз Ноа. Ключ грозовой печати усиливает молнии; Лук растущей Луны даёт силу, восприятие и дальность, а Милость природы активирует его эффект. Латный доспех преданий Сопротивления и Костяные поножи владыки огров заменяют две части Посмертия: часть урона от комплекта уступлена здоровью и защите.</p>\n<p>Цены аукциона не проверены. Нельзя гарантировать, что каждое выбранное украшение или две части командира авангарда будут дешёвыми на конкретном сервере. Уже улучшенную вещь сохраняйте до подготовки полноценной замены. Не покупайте весь комплект одновременно и не переходите с полностью развитой T1-вещи на T2 без подходящих свойств.</p>\n<h3>Приоритет улучшений</h3>\n<ol><li>Сохранить рабочий комплект и сначала развить основные умения. Ключ грозовой печати брать, если его получение доступнее уже имеющегося посоха; хорошее развитое оружие ради названия не менять.</li><li>Оружие: меткость, шанс мощной атаки, шанс критического удара. На броне — совместимые с вещью устойчивости, здоровье; на украшениях — повышение урона умений и сопротивление умениям, где доступны.</li><li>Восприятие довести до 80 при сохранении силы не ниже 50 и стойкости 30. Затем улучшать меткость и урон. Против противников с высоким уклонением стартовой меткости этой сборки может не хватить: выбирать менее уклоняющиеся цели и постепенно развивать руны/снаряжение.</li><li>Руны в расчёте 30-го уровня. Атакующие — общая меткость; защитные и поддержка сохраняют устойчивость и сопротивление умениям. Следующий этап — повышение рун до 60, затем дальнейшее развитие.</li><li>Артефакты: 2 Архизавра (+100 меткости), 2 Ока алчности (+100 устойчивости), 2 Тёмного вершителя (+12 снижения урона). Случайные дополнительные свойства не заданы; берите полезные выпавшие варианты. Соларстон Ока алчности — дополнительный выход из перечисленных в его описании эффектов опрокидывания.</li><li>Резонансы отключены. Не тратить минимальный бюджет на поиск идеального случайного резонанса.</li></ol>\n<h3>Уровни и расчёт</h3>\n<p>Усиление +12 и свойства 4/4 — цель постепенного развития, а не требование для начала игры с 5800 ГС. Вложено 54 очка характеристик, специализации 100/100. Мастерство в модели: 200 на посох и 200 на лук, общий уровень 520 — расчётный ориентир. Если фактические уровни ниже, доступные узлы и итоговые характеристики будут другими. Сайт предупреждает о неполном расчёте случайных свойств артефактов; цифры не являются гарантией характеристик персонажа.</p>\n<h3>Как играть</h3>\n<ol><li>Держать дистанцию и позицию за союзниками. Сосредоточенный разум использовать перед окном урона; Милость природы сочетать с Полевой медициной для восстановления через Жизнелюбие.</li><li>Открытие по доступной цели: Опутывающая стрела, Огненная сфера для давления на лечение, Ледяные иглы, Цепная молния и Карающий разряд. Учитывать блок противника и готовность его снятия контроля.</li><li>Связка лука: Множественный выстрел и Порыв ветра для расходования Шквала. Чередовать урон с перемещением; не стоять ради пассивных бонусов, когда на персонажа выходят бойцы ближнего боя.</li><li>Холодную гробницу сохранять для контроля опасной цели и разрыва дистанции. Защитное умение применять по читаемым атакам, Внутренний покой — в безопасном окне для восстановления маны.</li></ol>\n<h3>Для массового PvP</h3>\n<p>Это панель для малых стычек. Для осад и больших боёв нужен отдельный набор с Штормовой стрелой и Стрелой зари, специализациями на массовое воздействие и игрой по команде. Не считать эту панель универсальной для всех форматов PvP.</p>","url":"https://tl-build.ru/build/7129"}