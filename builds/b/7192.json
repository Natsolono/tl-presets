Attack_trait_1"]],["WP_SP_S_RapidThrust",15,["SkillSet_WP_SP_S_RapidThrust_trait_2"]],["WP_SP_S_RapidAttack",15,["SkillSet_WP_SP_S_RapidAttack_trait_1","SkillSet_WP_SP_S_RapidAttack_trait_3"]],["WP_SP_S_AbnormalTolerance",15,["SkillSet_WP_SP_S_AbnormalTolerance_trait_3","SkillSet_WP_SP_S_AbnormalTolerance_trait_4"]],["WP_SP_S_CrossAttack",15,[]],["WP_SP_S_PushAttack",15,[]],["WP_SW2_S_LeapAttack",15,["SkillSet_WP_SW2_S_LeapAttack_trait_1","SkillSet_WP_SW2_S_LeapAttack_trait_2"]],["WP_SP_S_SpearThrower",15,["SkillSet_WP_SP_S_SpearThrower_trait_1","SkillSet_WP_SP_S_SpearThrower_trait_2"]]],"pas":[["WP_SW2_S_CurrentHpBuff",15,[]],["WP_SW2_S_MaxHPUp",15,[]],["WP_SW2_S_StunSuccecsDamageBoost",15,[]],["WP_SW2_S_StunMaster",15,[]],["WP_SW2_S_SkillMaster",15,[]],["WP_SP_S_Passive_MoveBuff",15,[]],["WP_SP_S_Passive_AttackedBuff",15,[]],["WP_SW2_S_HittedBuff",15,[]]],"def":["WP_SP_S_CounterMove",15,[]],"art":[["talistone1","talistone_a_set_05_001",[["bonus_attack_power_main_hand",9],["melee_double_attack",600]]],["talistone2","talistone_a_set_05_002",[["all_armor",160]]],["talistone3","talistone_a_set_05_003",[["hp_max",1600]]],["talistone4","talistone_a_set_05_004",[]],["gemstone1","gemstone_a_set_05_001",[["stun_accuracy",2400],["collide_amplification",2400]]],["gemstone2","gemstone_a_set_05_002",[]]],"ms":{"SW2":{"Sword2h_Normal_Attack_02":10,"Sword2h_Normal_TacticAttack_12":10,"Sword2h_Normal_Tactic_11":10,"Sword2h_Normal_AttackUtil_03":10,"Sword2h_High_Attack_01":10,"Sword2h_High_Attack_02":10,"Sword2h_High_Tactic_11":10,"Sword2h_High_Tactic_10":10,"Sword2h_High_Util_04":10,"Sword2h_High_AttackUtil_03":10,"Sword2h_Rare_Attack_01":10,"Sword2h_Rare_Attack_02":10,"Sword2h_Rare_TacticAttack_12":10,"Sword2h_Rare_Tactic_11":10,"Sword2h_Rare_Defense_08":10,"Sword2h_Rare_UtilDefense_06":10,"Sword2h_Rare_AttackUtil_03":10,"Sword2h_Hero_Attack_01":10,"Sword2h_Hero_Tactic_04":10,"Sword2h_Normal_Defense_08":10},"SP":{"Spear_Normal_Attack_01":10,"Spear_Normal_Tactic_11":10,"Spear_Normal_Defense_07":10,"Spear_Normal_AttackUtil_03":10,"Spear_High_TacticAttack_12":10,"Spear_High_Tactic_11":10,"Spear_High_UtilDefense_06":9,"Spear_High_Util_05":10,"Spear_Rare_Attack_02":10,"Spear_Rare_TacticAttack_12":9,"Spear_Rare_Tactic_11":10,"Spear_Rare_Tactic_10":10,"Spear_Rare_Defense_07":10,"Spear_Rare_Defense_08":10,"Spear_Rare_UtilDefense_06":10,"Spear_Rare_Util_05":10,"Spear_Rare_Util_04":10,"Spear_Rare_AttackUtil_03":10,"Spear_Hero_Tactic_04":10,"Spear_Hero_Util_02":10,"Spear_Rare_DefenseTactic_09":2}},"msl":650,"msw":{},"msc":["WM_Common_SKILL_008","WM_Common_SKILL_009","WM_Common_SKILL_010","WM_Common_SKILL_007"],"n":"Билд","calc":""}],"desc":"<h2>Абсолютный ультимативный билд на Гладиатора</h2>\nЯ не вставлял характеристики в артефакты, поэтому статы будут ниже, <b>обратите на это внимание!</b>\n\n<h2>В чем смысл билда?</h2>\n\nСмысл в том, что мы делаем упор на базовый урон и мощную атаку для нанесения урона, что нас избавляет от прокачки ловкости и крита. \n<b>Что такое базовая атака?</b> Это значение урона, к примеру 500-700, где 500 как раз это ваша база, она всегда бьет, а 700 это крит, если выскачит. Мы делаем упор не на казино, это я про крит, который, возможно, кританет и прокнет 700). Мы делаем упор на то, чтобы всегда бить базой и больно, поэтому нам так нужна <b>сила</b> и <b>стойкость</b>, именно они дают буст к базе. \n<blockquote>База — наше всё!</blockquote>\n\n<h2>Броня авангарда</h2>\nЭто безумно сильная броня для нас с вами, так как ее статы просто конфетка, так еще нам накидует устойчивость и 30 БАЗЫ!\nТак как это тяжелая броня, делаем упор на <b>устойчивость от ближнего боя</b>. Это позволит нам дефаться от копья, двуруча и танка и другого глада, можно сказать, что вы сказали криту врага <b>нет!</b>\n\n<h2>Как улучшить билд?</h2>\nИ так, если у вас деньги или вам выпало что с Небулы, очень классное будет вот это [[item:necklace_aa2_t1_normal_010]] и [[item:ring_aa2_t1_normal_020]], это, наверно, имба для этого билда, но тут казино, как говорится, или карта вашей мамы)\n2) Чем жестко качнем билд? Это хаус руны на меткость, шанс мощной атаки или устойчивость ближний бой.\n\n<h2>Дядя, что делать с магами, больно в попу!</h2>\nОтвет: терпите! Ладно, шучу, вы думали, для чего я поставил данные артефакты и кидал много рун на сопротивлению умений, именно для этого! Это хоть как-то спасет от DPS мага и других персов, а с устой от ближнего боя вас сложно в принципе убить копейщику и т. д.\n\n\n<h3>Жду ваши комментарии, если нужна будет ротация, напишите, я распишу ее или еще что-то.</h3>\n\n<h2>Ротация скиллов</h2>\n[[skill:WP_SP_S_AbnormalTolerance]][[skill:WP_SW2_S_DashAttack]][[skill:WP_SW2_S_UpperAttack]][[skill:WP_SW2_S_PowerAttack]][[skill:WP_SW2_S_StunAttack]][[skill:WP_SW2_S_GaiaCrash]]\nЗа данную ротацию навряд ли кто-то выживет вообще, если оковы не срабатывают, то даем [[skill:WP_SW2_S_StunAttack]][[skill:WP_SW2_S_UpperAttack]][[skill:WP_SW2_S_PowerAttack]]\n\n<h2>Ротация 2 против арбы</h2>\n[[skill:WP_SP_S_AbnormalTolerance]][[skill:WP_SW2_S_DashAttack]][[skill:WP_SP_S_RapidThrust]][[skill:WP_SP_S_CrossAttack]][[skill:WP_SP_S_SpearThrower]]\nВлетаем, стакаем пламя, взрываем его, арба обычно отлетает. Первую ротацию лучше не использовать против опытных арбалетов, они доджат стан и т. д. дешем.\n\n<h2>Ротация масс PVP</h2>\n[[skill:WP_SP_S_AbnormalTolerance]][[skill:WP_SW2_S_DashAttack]][[skill:WP_SW2_S_LeapAttack]][[skill:WP_SP_S_PushAttack]][[skill:WP_SP_S_RapidThrust]][[skill:WP_SP_S_RapidAttack]][[skill:WP_SP_S_SpearThrower]] Все огонь, просто нет таких иконок.\nБаффаемся, влетаем станем всех через [[skill:WP_SW2_S_LeapAttack]] потом даем импульс всем и так роняем через[[skill:WP_SP_S_PushAttack]] и убиваем (О_О)","url":"https://tl-build.ru/build/7192"}