on",4],["kHpMax",4]],"ru":[["Assist","AA","heal_modifier",60],["Attack","AA","melee_critical_attack",60],["Defense","AA","melee_critical_defense",60]]},{"s":"ring2","id":"ring_aa_t1_nomal_003","e":9,"t":[["kCostRegen",4],["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4]],"ru":[["Assist","AA","heal_modifier",60],["Attack","AA","melee_critical_attack",60],["Defense","AA","melee_critical_defense",60]]},{"s":"bracelet","id":"bracelet_aa_t1_nomal_002","e":9,"t":[["kCostRegen",4],["kSkillPowerResistance",4],["kWeakenTolerance",4]],"ru":[["Attack","AA","melee_double_attack",60],["Assist","AA","skill_power_resistance",60],["Defense","AA","melee_critical_defense",60]]},{"s":"belt","id":"belt_aa_t1_nomal_004","e":9,"t":[["kHpMax",4],["kSkillPowerResistance",4],["kSilenceTolerance",4]],"ru":[["Attack","AA","melee_accuracy",60],["Assist","AA","skill_power_resistance",60],["Defense","AA","melee_critical_defense",60]]}],"act":[["WP_SP_S_ThrustPull",null,["SkillSet_WP_SP_S_ThrustPull_trait_1"]],["WP_SP_S_RapidThrust",null,["SkillSet_WP_SP_S_RapidThrust_trait_2"]],["WP_SP_S_DashAttack",null,[]],["WP_SP_S_AbnormalTolerance",null,["SkillSet_WP_SP_S_AbnormalTolerance_trait_4","SkillSet_WP_SP_S_AbnormalTolerance_trait_3","SkillSet_WP_SP_S_AbnormalTolerance_trait_2"]],["WP_SP_S_CrossAttack",null,["SkillSet_WP_SP_S_CrossAttack_trait_2","SkillSet_WP_SP_S_CrossAttack_trait_3"]],["WP_SP_S_RapidAttack",null,["SkillSet_WP_SP_S_RapidAttack_trait_1"]],["WP_WA_GR_S_Corruption",null,["SkillSet_WP_WA_GR_S_Corruption_trait_2"]],["WP_WA_GR_S_Decay",null,["SkillSet_WP_WA_GR_S_Decay_trait_1","SkillSet_WP_WA_GR_S_Decay_trait_2"]],["WP_WA_GR_S_DefenseUp",null,["SkillSet_WP_WA_GR_S_DefenseUp_trait_1"]],["WP_WA_GR_S_HealField",null,["SkillSet_WP_WA_GR_S_HealField_trait_1","SkillSet_WP_WA_GR_S_HealField_trait_3"]],["WP_SP_S_StunAttack",null,["SkillSet_WP_SP_S_StunAttack_trait_2","SkillSet_WP_SP_S_StunAttack_trait_3"]],["WP_SP_S_SpearThrower",null,["SkillSet_WP_SP_S_SpearThrower_trait_1"]]],"pas":[["WP_SP_S_Passive_ComboBuff",null,[]],["WP_SP_S_Passive_LowHPAttack",null,[]],["WP_SP_S_Passive_WeakenkBonus",null,[]],["WP_SP_S_Passive_TwoHandWeaponBonus",null,[]],["WP_WA_GR_S_CurseAttackHeal",null,[]],["WP_WA_GR_S_SupportAllyCostRegenUp",null,[]],["WP_WA_GR_S_HealEffectUpWhenSkillDamageTaken",null,[]],["WP_SP_S_Passive_AttackedBuff",null,[]]],"def":["WP_SP_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"","calc":"eyJ2IjoyLCJuYW1lIjoiVm9pZGxhbmNlINC_0LLQtVxc0L_QstC_INC_"}],"desc":"Немного хочу сказать про меткость. На первый взгляд может показаться, что её не хватает, но благодаря специализации [[spec:WP_SP_S_AbnormalTolerance|SkillSet_WP_SP_S_AbnormalTolerance_trait_4]] меткость становится 1085, и в принципе этого должно хватить.<br><br>Последовательность скилов:<br><br>ПвП:<br>Начинаем с [[skill:WP_WA_GR_S_Decay]] и [[skill:WP_WA_GR_S_DefenseUp]], затем максимально баффаем себя через [[skill:WP_SP_S_AbnormalTolerance]]. После этого используем [[skill:WP_WA_GR_S_Corruption]] для отхила и дополнительного урона. Сближаемся с целью с помощью [[skill:WP_SP_S_DashAttack]]. Как только сблизились, кидаем 2 раза [[skill:WP_SP_S_ThrustPull]], чтобы снизить сопротивление стану, и сразу применяем [[skill:WP_SP_S_StunAttack]]. Также не забываем кинуть под себя [[skill:WP_WA_GR_S_HealField]] — благодаря [[skill:WP_WA_GR_S_SupportAllyCostRegenUp]] мы не будем просаживаться по мане. Вообще, желательно держать фулл стаки по кд, но это достаточно сложно.<br><br>Далее идёт [[skill:WP_SP_S_RapidAttack]] — набиваем стаки травмы, после чего прожимаем [[skill:WP_SP_S_CrossAttack]] и [[skill:WP_SP_S_RapidThrust]]. Если вам тяжело выживать, можно заменить [[skill:WP_SP_S_SpearThrower]] на [[skill:WP_WA_GR_S_Heal]], так как [[skill:WP_SP_S_SpearThrower]] для меня скорее добивающий скилл или используется только в застаке.<br><br>ПвЕ:<br>Баффаемся через [[skill:WP_WA_GR_S_Decay]], [[skill:WP_WA_GR_S_DefenseUp]] и [[skill:WP_SP_S_AbnormalTolerance]], накидываем [[skill:WP_WA_GR_S_Corruption]] для отхила. После этого стакаем травму с помощью 2х [[skill:WP_SP_S_ThrustPull]] и [[skill:WP_SP_S_RapidAttack]], затем кидаем [[skill:WP_SP_S_StunAttack]], а после него — [[skill:WP_SP_S_RapidThrust]]. Если это пак мобов, используем [[skill:WP_SP_S_SpearThrower]], если босс — [[skill:WP_SP_S_CrossAttack]].<br><br>","url":"https://tl-build.ru/build/1712"}