ical_attack",60],["Defense","AA","range_evasion",60],["Assist","AA","weaken_accuracy",60]]},{"s":"ring2","id":"ring_aa_t1_nomal_009","e":9,"t":[["kHpMax",4],["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4]],"ru":[["Attack","AA","melee_critical_attack",60],["Defense","AA","range_evasion",60],["Assist","AA","weaken_accuracy",60]]},{"s":"bracelet","id":"bracelet_aa_t1_nomal_002","e":9,"t":[["kDebuffTakenDurationModifier",4],["kCostRegen",4],["kSkillPowerResistance",4]],"ru":[["Assist","AA","blind_accuracy",60],["Defense","AA","range_double_defense",60],["Attack","AA","melee_double_attack",60]]},{"s":"belt","id":"belt_aa_t1_nomal_004","e":9,"t":[["kDebuffTakenDurationModifier",4],["kHpMax",4],["kSkillPowerResistance",4]],"ru":[["Assist","AA","stun_accuracy",60],["Defense","AA","range_double_defense",60],["Attack","AA","melee_accuracy",60]]}],"act":[["WP_ST_S_WideAreaAttack",15,["SkillSet_WP_ST_S_WideAreaAttack_trait_3","SkillSet_WP_ST_S_WideAreaAttack_trait_4","SkillSet_WP_ST_S_WideAreaAttack_trait_5"]],["WP_WA_GR_S_CurseArea",15,["SkillSet_WP_WA_GR_S_CurseArea_trait_1","SkillSet_WP_WA_GR_S_CurseArea_trait_3"]],["WP_WA_GR_S_Corruption",15,["SkillSet_WP_WA_GR_S_Corruption_trait_2","SkillSet_WP_WA_GR_S_Corruption_trait_3"]],["WP_WA_GR_S_CurseSpread",15,["SkillSet_WP_WA_GR_S_CurseSpread_trait_1","SkillSet_WP_WA_GR_S_CurseSpread_trait_3"]],["WP_ST_S_FireCombo",15,["SkillSet_WP_ST_S_FireCombo_trait_1","SkillSet_WP_ST_S_FireCombo_trait_2"]],["WP_ST_S_PowerAttack",15,[]],["WP_ST_S_WideAreaPowerAttack",15,["SkillSet_WP_ST_S_WideAreaPowerAttack_trait_1","SkillSet_WP_ST_S_WideAreaPowerAttack_trait_2"]],["WP_WA_GR_S_CurseBurst",15,["SkillSet_WP_WA_GR_S_CurseBurst_trait_2","SkillSet_WP_WA_GR_S_CurseBurst_trait_3"]],["WP_ST_S_GlobalCoolDownBuff",15,["SkillSet_WP_ST_S_GlobalCoolDownBuff_trait_2"]],["WP_WA_GR_S_DefenseUp",15,["SkillSet_WP_WA_GR_S_DefenseUp_trait_1"]],["WP_ST_S_ManaRengeUp",15,[]],["WP_WA_GR_S_Decay",15,["SkillSet_WP_WA_GR_S_Decay_trait_1"]]],"pas":[["WP_WA_GR_S_CurseAttackHeal",15,[]],["WP_WA_GR_S_CurseDuration",15,[]],["WP_WA_GR_S_DayHealNightCurse",15,[]],["WP_ST_S_ManaRegenBuff",15,[]],["WP_ST_S_SkillPowerAmplificationBuff",15,[]],["WP_ST_S_MaxManaUp",15,[]],["WP_ST_S_AddProjectile",15,[]],["WP_ST_S_BurnTargetAddDamage",15,[]]],"def":["WP_WA_GR_S_CounterMove",15,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"Mercy Invocator PvE","calc":"eyJ2IjoyLCJuYW1lIjoiVDEg0LHQuNC70LQgfCDQktC30YDRi9CyINC_"}],"desc":"<h2>Описание</h2>\n\nДанный билд построен вокруг максимального урона от <b>Бедственного слова</b> за счёт накопления проклятий и эффектов воспламенения.\n\nПри срабатывании <b>мощной атаки</b> и <b>критического удара</b> Бедственное слово способно наносить <b>90 000+ урона</b> одним применением.\nВ среднем по моим замерам получается выдать ДПС, примерно, 500к урона в минуту днём или же 750к в минуту ночью. Замеры производил на мишенях.\n\nГлавная особенность билда - <b>не спешить использовать Бедственное слово</b>. Сначала необходимо максимально усилить персонажа собственными бафами, накопить на цели проклятия и воспламенение, увеличить длительность проклятий, и только после этого взорвать их, мгновенно нанеся <b>весь оставшийся урон от активных эффектов</b>.\n\nУрон Бедственного слова отлично масштабируется практически от всех основных источников усиления:\n\n<ul>\n<li>Повышение урона умений;</li>\n<li>Базовый урон;</li>\n<li>Стеллариты;</li>\n<li>Мощная атака;</li>\n<li>Критический удар.</li>\n</ul>\n\nБлагодаря вампиризму от пассивных навыков билд обладает высоким сустейном и позволяет в одиночку проходить часть боссов Чертогов Тьмы II (при отсутствии обязательных групповых механик).\n\nОтдельно стоит отметить выбор экипировки с бонусом <b>+7.5% к длительности ослаблений</b>. Для данного билда это один из ключевых бонусов, поскольку увеличение времени действия проклятий напрямую повышает итоговый урон Бедственного слова - во время взрыва наносится весь оставшийся урон от активных проклятий.\n\n<h2>Ротация</h2>\n\nПеред началом боя обязательно поддерживаем на себе все основные усиления. Несмотря на то, что редактор билдов отображает их не совсем корректно, суммарно персонаж получает:\n\n<ul>\n<li><b>+22%</b> к силе умений;</li>\n<li><b>+58%</b> к скорости восстановления умений;</li>\n<li><b>+137</b> базового урона.</li>\n</ul>\n\nЗа счёт увеличенной длительности положительных эффектов эти бафы имеют очень высокий аптайм и большую часть времени поддерживаются без перерывов.\n\n<h3>Селф-бафы</h3>\n\n<ul>\n<li>[[skill:WP_ST_S_ManaRengeUp]] - активируем непосредственно перед началом ротации и сразу отменяем. Даже короткого применения достаточно, чтобы получить <b>96% эффективности расхода маны</b>. Без этого эффекта мана заканчивается очень быстро.</li>\n\n<li>[[skill:WP_ST_S_GlobalCoolDownBuff]]</li>\n\n<li>[[skill:WP_WA_GR_S_Decay]]</li>\n\n<li>[[skill:WP_WA_GR_S_DefenseUp]]</li>\n</ul>\n\n<h3>Основная ротация</h3>\n\n<ol>\n<li>Используем [[skill:WP_ST_S_WideAreaPowerAttack]].</li>\n\n<li>Накладываем [[skill:WP_WA_GR_S_Corruption]].</li>\n\n<li>Используем [[skill:WP_WA_GR_S_CurseArea]] (специализация [[spec:WP_WA_GR_S_CurseArea|SkillSet_WP_WA_GR_S_CurseArea_trait_1]]).</li>\n\n<li>Повторно применяем [[skill:WP_WA_GR_S_Corruption]].</li>\n\n<li>Продлеваем действие всех наложенных проклятий с помощью [[skill:WP_WA_GR_S_CurseSpread]].</li>\n\n<li>Используем [[skill:WP_ST_S_FireCombo]]. Количество выпущенных огненных шаров напрямую зависит от количества эффектов воспламенения на цели. После первой ротации старайтесь использовать этот навык только после повторного набора стаков воспламенения (например, после Метеорита или Огненных зарядов).</li>\n\n<li><b>Важно!</b> Стараемся применять[[skill:WP_ST_S_PowerAttack]] <b>до</b> Бедственного слова. Бедственное слово поглощает стаки воспламенения, а именно они повышают шанс мощной атаки благодаря пассивке [[skill:WP_ST_S_BurnTargetAddDamage]].</li>\n\n<li>Используем [[skill:WP_WA_GR_S_CurseBurst]] - основной источник урона данного билда.</li>\n\n<li>После взрыва обновляем воспламенение с помощью [[skill:WP_ST_S_WideAreaAttack]], поддерживаем проклятия и продолжаем ротацию по мере восстановления основных навыков.</li>\n</ol>\n\n[[skill:WP_ST_S_ManaRengeUp]] рекомендую использовать совместно с [[skill:WP_BO_S_RegenAura]] если в пати есть хил. Эта комбинация позволяет восстановить практически весь запас маны всего за несколько секунд.\n\n<h3>Рекомендации</h3>\n\n<ul>\n<li><b>Не спешите использовать Бедственное слово сразу после отката.</b> В большинстве случаев предварительное накопление максимального количества проклятий и воспламенения даст значительно больший прирост ДПС, чем преждевременный взрыв.</li>\n\n<li>Следите за поддержанием селф-бафов - значительная часть итогового урона билда достигается именно за счёт их высокого аптайма.</li>\n\n<li>Старайтесь не допускать простоя проклятий на цели - именно они являются основой всего урона билда.</li>\n</ul>","url":"https://tl-build.ru/build/2672"}