on",3],["kHpMax",3]]},{"s":"ring2","id":"ring_aa_t1_nomal_009","e":9,"t":[["kHpMax",4],["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4]],"ru":[["Assist","AA","heal_modifier",60],["Attack","AA","all_critical_attack",80],["Defense","AA","cost_regen",80]]},{"s":"bracelet","id":"bracelet_aa_t1_nomal_004","e":9,"t":[["kHpMax",4],["kSkillPowerResistance",4],["kDebuffTakenDurationModifier",4]],"ru":[["Attack","AA","all_double_attack",80],["Assist","AA","cost_consumption_modifier",60],["Defense","AA","cost_regen",80]]},{"s":"belt","id":"belt_a_t2_addoption_004","e":9,"t":[],"ru":[["Assist","AA","cost_consumption_modifier",60],["Defense","AA","cost_regen",80],["Attack","AA","boss_all_double_attack",80]]}],"act":[["WP_WA_GR_S_Corruption",null,[]],["WP_ST_S_MainAttack",null,["SkillSet_WP_ST_S_MainAttack_trait_1"]],["WP_WA_GR_S_CurseBurst",null,["SkillSet_WP_WA_GR_S_CurseBurst_trait_1","SkillSet_WP_WA_GR_S_CurseBurst_trait_2","SkillSet_WP_WA_GR_S_CurseBurst_trait_3"]],["WP_WA_GR_S_CurseArea",null,["SkillSet_WP_WA_GR_S_CurseArea_trait_1"]],["WP_ST_S_ManaRengeUp",null,["SkillSet_WP_ST_S_ManaRengeUp_trait_1","SkillSet_WP_ST_S_ManaRengeUp_trait_2"]],["WP_WA_GR_S_Decay",null,["SkillSet_WP_WA_GR_S_Decay_trait_1","SkillSet_WP_WA_GR_S_Decay_trait_2"]],["WP_WA_GR_S_DefenseUp",null,["SkillSet_WP_WA_GR_S_DefenseUp_trait_1"]],["WP_ST_S_WideAreaPowerAttack",null,["SkillSet_WP_ST_S_WideAreaPowerAttack_trait_1","SkillSet_WP_ST_S_WideAreaPowerAttack_trait_2"]],["WP_ST_S_PowerAttack",null,[]],["WP_ST_S_FireCombo",null,["SkillSet_WP_ST_S_FireCombo_trait_1","SkillSet_WP_ST_S_FireCombo_trait_2"]],["WP_ST_S_WideAreaAttack",null,["SkillSet_WP_ST_S_WideAreaAttack_trait_2","SkillSet_WP_ST_S_WideAreaAttack_trait_4","SkillSet_WP_ST_S_WideAreaAttack_trait_5"]],["WP_ST_S_GlobalCoolDownBuff",null,["SkillSet_WP_ST_S_GlobalCoolDownBuff_trait_2"]]],"pas":[["WP_ST_S_ManaRegenBuff",null,[]],["WP_ST_S_MaxManaUp",null,[]],["WP_ST_S_BurnTargetAddDamage",null,[]],["WP_ST_S_SkillPowerAmplificationBuff",null,[]],["WP_WA_GR_S_CurseKillBonus",null,[]],["WP_WA_GR_S_DayHealNightCurse",null,[]],["WP_WA_GR_S_CurseDuration",null,[]],["WP_WA_GR_S_CurseAttackHeal",null,[]]],"def":["WP_ST_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"","calc":"eyJ2IjoyLCJuYW1lIjoi0JjQvdCy0L7QutC10YAg0J_"}],"desc":"Билд основан на сборке ютубера Grobs, который берёт топ 1 места на мировых боссах по урону в актуальной версии EU TL.<br><br>Это очень бюджетный билд, который подойдёт для твинков. В Т2 нужно будет поменять только палочку и ожерелье из Т2 контента, все остальные шмотки сохраняются из Т1.<br><br>Идея билда в бонус уроне, который мы забираем везде где можем. Постоянный прок бонус урона + высокая скорость атаки и спам скиллов выдаёт огромный урон по боссам.<br><br>Есть 2 версии скилл билда:<br>1. Через взрыв проклятий с их удалением через [[skill:WP_WA_GR_S_CurseBurst]] без пассивки [[spec:WP_WA_GR_S_CurseBurst|SkillSet_WP_WA_GR_S_CurseBurst_trait_1]], в следсвие чего основной урон у нас будет от [[skill:WP_WA_GR_S_CurseBurst]].<br>2. Через постоянные взрывы без удаления проклятий с пассивкой [[spec:WP_WA_GR_S_CurseBurst|SkillSet_WP_WA_GR_S_CurseBurst_trait_1]] в скилле [[skill:WP_WA_GR_S_CurseBurst]]. Это текущий скилл билд который я выбрал для себя. Урон у скилла снижается, но вырастает урон у других скиллов.<br>По итогу, урон у этих 2 версий одинаковый и в каком стиле играть выбираете вы. Другой вариант вы можете посмотреть на ютуб канале Grobs.<br><br>Так же нужно сказать про Т1 пассивку [[skill:WP_WA_GR_S_DayHealNightCurse]]. Мы хотим ходить на боссов и в данжи где всегда ночь, чтобы эта пассивка работала для нас. Если в данже день, её можно смело менять на любую другую. <br>В Т2 с помощью мастерок эту пассивку можно будет апнуть так, что оба эффекта (день\\ночь) будут работать в любое время суток. <br><br>Проблемы с маной:<br>На первое время пока не много манарегена, мы берём скилл[[skill:WP_ST_S_ManaRengeUp]] с[[spec:WP_ST_S_ManaRengeUp|SkillSet_WP_ST_S_ManaRengeUp_trait_1]]. Используем по кд почти вплотную к боссу, чтобы хоть как-то дамажить пока восстанавливаем ману.<br>Далее по мере прокачки трейтов и рун на манареген, можно будет отказаться от[[skill:WP_ST_S_ManaRengeUp]]<br>и взять вместо него [[skill:WP_ST_S_IceSpear]] с пассивками[[spec:WP_ST_S_IceSpear|SkillSet_WP_ST_S_IceSpear_trait_1]]и[[spec:WP_ST_S_IceSpear|SkillSet_WP_ST_S_IceSpear_trait_3]]<br><br>РОТАЦИЯ:<br>Начинаем с забафа[[skill:WP_ST_S_GlobalCoolDownBuff]][[skill:WP_WA_GR_S_DefenseUp]][[skill:WP_WA_GR_S_Decay]]<br>Далее[[skill:WP_WA_GR_S_Corruption]][[skill:WP_WA_GR_S_CurseArea]]<br>Пока летит плюха от Ритуального круга кастуем[[skill:WP_ST_S_WideAreaPowerAttack]]<br>Как раз после каста долетает плюха от круга + падает метеорит и вешает стаки воспламенения<br>Поэтому мы это всё взрываем[[skill:WP_WA_GR_S_CurseBurst]]<br>Далее идут спам скиллы:<br>начинаем с [[skill:WP_ST_S_WideAreaAttack]]и[[skill:WP_ST_S_FireCombo]]чтобы добавить стак воспламенения[[skill:WP_ST_S_MainAttack]][[skill:WP_ST_S_PowerAttack]][[skill:WP_ST_S_IceSpear]]/[[skill:WP_ST_S_ManaRengeUp]]<br>После этого - Возвращаемся в начало ротации","url":"https://tl-build.ru/build/172"}