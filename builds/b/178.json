9,"t":[["kHpMax",4],["kBuffGivenDurationModifier",4],["kSkillPowerAmplification",4]],"ru":[["Assist","A","skill_heal_taken_modifier",60],["Defense","A","hp_max",60],["Attack","A","boss_magic_double_attack",60]]},{"s":"bracelet","id":"bracelet_a_t2_addoption_004","e":9,"t":[["kSkillPowerResistance",4],["kCostRegen",4],["kDebuffTakenDurationModifier",4]],"ru":[["Assist","A","skill_power_resistance",60],["Defense","A","hp_max",60],["Attack","A","boss_magic_double_attack",60]]},{"s":"belt","id":"belt_aa_t1_nomal_003","e":9,"t":[["kSkillPowerResistance",4],["kDebuffTakenDurationModifier",4],["kCostRegen",4]],"ru":[["Assist","A","stun_accuracy",60],["Defense","A","hp_max",60],["Attack","A","boss_magic_double_attack",60]]}],"act":[["WP_WA_GR_S_Corruption",null,["SkillSet_WP_WA_GR_S_Corruption_trait_2"]],["WP_WA_GR_S_CurseBurst",null,["SkillSet_WP_WA_GR_S_CurseBurst_trait_1","SkillSet_WP_WA_GR_S_CurseBurst_trait_3","SkillSet_WP_WA_GR_S_CurseBurst_trait_2"]],["WP_WA_GR_S_Decay",null,["SkillSet_WP_WA_GR_S_Decay_trait_1"]],["WP_WA_GR_S_DefenseUp",null,["SkillSet_WP_WA_GR_S_DefenseUp_trait_1","SkillSet_WP_WA_GR_S_DefenseUp_trait_3"]],["WP_ST_S_PowerAttack",null,[]],["WP_ST_S_WideAreaPowerAttack",null,["SkillSet_WP_ST_S_WideAreaPowerAttack_trait_1","SkillSet_WP_ST_S_WideAreaPowerAttack_trait_2"]],["WP_ST_S_FireCombo",null,["SkillSet_WP_ST_S_FireCombo_trait_1","SkillSet_WP_ST_S_FireCombo_trait_2"]],["WP_ST_S_ManaRengeUp",null,[]],["WP_ST_S_MainAttack",null,["SkillSet_WP_ST_S_MainAttack_trait_1"]],["WP_ST_S_WideAreaAttack",null,["SkillSet_WP_ST_S_WideAreaAttack_trait_1","SkillSet_WP_ST_S_WideAreaAttack_trait_2","SkillSet_WP_ST_S_WideAreaAttack_trait_4"]],["WP_ST_S_GlobalCoolDownBuff",null,["SkillSet_WP_ST_S_GlobalCoolDownBuff_trait_2"]],["WP_WA_GR_S_CurseArea",null,["SkillSet_WP_WA_GR_S_CurseArea_trait_1"]]],"pas":[["WP_ST_S_AddProjectile",null,[]],["WP_ST_S_ManaRegenBuff",null,[]],["WP_ST_S_MaxManaUp",null,[]],["WP_ST_S_BurnTargetAddDamage",null,[]],["WP_ST_S_SkillPowerAmplificationBuff",null,[]],["WP_WA_GR_S_DayHealNightCurse",null,[]],["WP_WA_GR_S_CurseDuration",null,[]],["WP_WA_GR_S_CurseAttackHeal",null,[]]],"def":["WP_WA_GR_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"","calc":""}],"desc":"Основной прикол билда в атакспиде, постоянных баффах на себе и огромных кдрах, которые вкупе с атакспидом позволяют спамить кнопками нонстоп (напоминаю что атакспид увеличивает скорость анимаций, и все скиллы кастуются быстрее, даже те у которых нет подготовки). В руках держим палочку, чтобы получать бонус +2 к мудрости и добивать 50 поинтов для кдров, а также чтобы чаще прокать метки луков засчет огромного (4-5 тычек в секунду + доп тычки от пассивки посоха) атакспида. 50 силы в рамках т1 брать невыгодно, так как падает атакспид, падает кдр и падает длительность баффов, что сильно уменьшает демедж, взамен давая всего лишь 100 мощной атаки (около 8% шанса).<br>С кольцами и поясом в билде можно играться, менять их на другие варианты, главное чтобы в итоге в билде были именно такие статы, как здесь. Также можно не брать 4 куска сета Собирателя жизней, а вместо [[item:legs_leather_aa_t1_nomal_003]] и [[item:hands_leather_aa_t1_nomal_003]] взять [[item:legs_fabric_aa_t1_nomal_001]] и [[item:hands_leather_aa_t1_nomal_001]], что даст чуть больше атакспида и сет бонус от штанов и халата, но вы потеряете в крите. В целом, на мой взгляд, разница некритичная, и тот и тот вариант имеют место быть. <br>В билде указаны специализации для максимального урона в одну цель, для нанесения АОЕ урона нужно менять [[spec:WP_WA_GR_S_CurseBurst|SkillSet_WP_WA_GR_S_CurseBurst_trait_3]] и [[spec:WP_WA_GR_S_CurseBurst|SkillSet_WP_WA_GR_S_CurseBurst_trait_2]] на [[spec:WP_WA_GR_S_Corruption|SkillSet_WP_WA_GR_S_Corruption_trait_1]] и [[spec:WP_ST_S_WideAreaAttack|SkillSet_WP_ST_S_WideAreaAttack_trait_3]]<br><br>Если кому-то будет нужна ротация - пишите, я добавлю.","url":"https://tl-build.ru/build/178"}