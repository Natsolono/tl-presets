R_S_CurseSpread_trait_3"]],["WP_CR_CR_S_ArmorBreakShot",15,["SkillSet_WP_CR_CR_S_ArmorBreakShot_Trait_2"]],["WP_WA_GR_S_CurseBurst",15,["SkillSet_WP_WA_GR_S_CurseBurst_trait_1","SkillSet_WP_WA_GR_S_CurseBurst_trait_2","SkillSet_WP_WA_GR_S_CurseBurst_trait_3"]],["WP_CR_CR_S_BloodToSoul",15,["SkillSet_WP_CR_CR_S_BloodToSoul_Trait_1"]],["WP_CR_D_WeakPointShot",15,["SkillSet_WP_CR_D_WeakPointShot_Trait_2"]],["WP_WA_GR_S_LinkLaser",15,["SkillSet_WP_WA_GR_S_LinkLaser_trait_3"]]],"pas":[["WP_WA_GR_S_DayHealNightCurse",15,[]],["WP_WA_GR_S_HealEfficiencyByMaxCost",15,[]],["WP_WA_GR_S_CurseAttackHeal",15,[]],["WP_WA_GR_S_CurseDuration",15,[]],["WP_WA_GR_S_SupportAllyCostRegenUp",15,[]],["WP_CR_CR_S_WeakenAttackBonus",15,[]],["WP_CR_S_OffHandMaxDmg",15,[]],["WP_CR_CR_S_DistanceRangeAcc",15,[]]],"def":["WP_WA_GR_S_CounterMove",15,[]],"art":[["talistone1","talistone_a_set_02_001",[["bonus_attack_power_main_hand",9],["magic_double_attack",600],["attack_power_main_hand",6],["all_double_attack",480]]],["talistone2","talistone_a_set_02_002",[["all_armor",160],["all_evasion",600],["damage_reduction",8],["magic_evasion",900]]],["talistone3","talistone_a_set_02_003",[["hp_max",1600],["cost_max",450],["stamina_regen",6000],["stamina_max",10]]],["talistone4","talistone_a_set_02_004",[["bonus_attack_power_main_hand",7],["all_double_attack",480],["magic_double_attack",600],["all_critical_attack",480]]],["gemstone1","gemstone_a_set_02_001",[["weaken_accuracy",2400],["undead_damage_amplification",300]]],["gemstone2","gemstone_a_set_02_002",[["all_state_tolerance",1600],["undead_damage_resistance",300]]]],"ms":{"CR":{"Crossbow_Normal_Attack_01":10,"Crossbow_Normal_Attack_02":10,"Crossbow_Normal_TacticAttack_12":10,"Crossbow_Normal_UtilDefense_06":10,"Crossbow_Normal_Util_05":10,"Crossbow_Normal_AttackUtil_03":10,"Crossbow_High_TacticAttack_12":10,"Crossbow_High_DefenseTactic_09":10,"Crossbow_High_UtilDefense_06":10,"Crossbow_Rare_Attack_02":10,"Crossbow_Rare_TacticAttack_12":10,"Crossbow_Rare_Tactic_11":10,"Crossbow_Rare_Defense_07":10,"Crossbow_Rare_Defense_08":10,"Crossbow_Rare_Util_05":10,"Crossbow_Rare_Util_04":10,"Crossbow_Rare_AttackUtil_03":10,"Crossbow_Hero_Attack_01":10,"Crossbow_Hero_Util_02":10,"Crossbow_Normal_DefenseTactic_09":10},"WA_GR":{"Wand_Normal_DefenseTactic_09":10,"Wand_Normal_UtilDefense_06":10,"Wand_Normal_Util_04":10,"Wand_High_Attack_01":10,"Wand_High_Attack_02":10,"Wand_High_TacticAttack_12":10,"Wand_High_Tactic_11":10,"Wand_High_Tactic_10":10,"Wand_High_Util_05":10,"Wand_High_AttackUtil_03":10,"Wand_Rare_Attack_01":10,"Wand_Rare_Attack_02":10,"Wand_Rare_TacticAttack_12":10,"Wand_Rare_Tactic_11":10,"Wand_Rare_DefenseTactic_09":10,"Wand_Rare_Util_05":10,"Wand_Rare_Util_04":10,"Wand_Rare_AttackUtil_03":10,"Wand_Hero_Attack_01":10,"Wand_High_Util_04":10}},"msl":650,"msw":{},"msc":["WM_Common_SKILL_002","WM_Common_SKILL_007","WM_Common_SKILL_006","WM_Common_SKILL_009"],"n":"Билд","calc":"eyJ2IjoyLCJuYW1lIjoi0KTRg9GA0Y8g0J_"}],"desc":"<h2>Фурия: арбалеты и жезл</h2>\n\n<p>Фурия — сборка для нанесения высокого урона боссам. Мы накладываем на цель проклятия и другие периодические эффекты, сокращаем откат умений с помощью «Отрешённости» и наносим основной урон «Бедственным словом».</p>\n\n<h3>Как работает сборка</h3>\n\n<p>Ключевое умение — [[skill:WP_CR_S_GhostWalk]]. Пока действует «Отрешённость», успешное наложение ослаблений сокращает время восстановления остальных умений. Поэтому сборка стремится продлить её действие и как можно чаще накладывать ослабления на цель.</p>\n\n<p>В мастерствах и на экипировке по возможности набираем <strong>длительность положительных эффектов</strong>. Это увеличивает время действия «Отрешённости» и позволяет дольше поддерживать быстрый темп применения умений.</p>\n\n<p>Накладываем [[skill:WP_WA_GR_S_Corruption]] и другие периодические эффекты, затем используем [[skill:WP_WA_GR_S_CurseBurst]]. Во время «Отрешённости» [[skill:WP_CR_CR_S_RapidShot]] помогает наносить частые удары и поддерживать работу сборки.</p>\n\n<h3>Оружие и мастерство</h3>\n\n<p><strong>Во время боя держим в руках арбалеты.</strong> Так мы используем автоатаки и эффекты парного оружия, а частые попадания помогают постоянно накладывать ослабление от умения мастерства «Искра проклятий».</p>\n\n<p>Несмотря на русское описание, её эффект может сработать и от базовых атак арбалетами: успешная автоатака с вероятностью 15% накладывает на монстра один из эффектов — «Касание скорби», «Перст угасания» или «Час отмщения». Благодаря этому мы получаем дополнительные ослабления, продолжая держать в руках арбалеты.</p>\n\n<h3>Час отмщения</h3>\n\n<p>В текущем варианте [[skill:WP_WA_GR_S_Decay]] используется со специализацией <strong>«Час преодоления»</strong> и применяется на себя, повышая урон умений.</p>\n\n<p>Также можно использовать «Час отмщения» на цель без этой специализации: в таком случае умение снижает сопротивление цели урону умений и освобождает очки для других улучшений. Точная разница между вариантами пока не подтверждена, поэтому можно попробовать оба и выбрать подходящий для своей сборки.</p>\n\n<h3>Бедственное слово: с «Темнословием» или без</h3>\n\n<p>В текущем варианте [[skill:WP_WA_GR_S_CurseBurst]] используется с <strong>«Темнословием»</strong>. Эта специализация сохраняет периодические эффекты на цели после взрыва, но снижает урон от их взрыва на 50%. Проклятия продолжают действовать, поэтому перед следующим применением умения их не нужно набирать заново.</p>\n\n<p>Без «Темнословия» отдельный взрыв сильнее, но периодические эффекты рассеиваются и их приходится накладывать повторно. В некоторых сборках и ротациях такой вариант может дать больше урона.</p>\n\n<p>В моих тестах для этой сборки вариант с «Темнословием» показал больший общий урон. Результат зависит от ротации, длительности боя и выбранных специализаций, поэтому можно попробовать оба варианта.</p>\n\n<p><strong>«Глубокая скорбь»</strong> помогает быстрее набрать уровни «Касания скорби», но не увеличивает их максимум. Если проклятие стабильно поддерживается на цели благодаря «Темнословию», очки специализации можно вложить в другие улучшения.</p>\n\n<h3>Самоисцеление</h3>\n\n<p>[[skill:WP_WA_GR_S_CurseAttackHeal]] восстанавливает здоровье при атаках по цели под действием нашего проклятия. Если союзник не выбран, лечение получает сам персонаж.</p>\n\n<p>В обычном варианте не берём мастерство, изменяющее «Кровавый пакт», чтобы сохранить самоисцеление. В тайных подземельях или на Дайгоне, когда дополнительное лечение не требуется, это мастерство можно взять для увеличения урона.</p>\n\n<h3>Замена умений</h3>\n\n<p>[[skill:WP_CR_CR_S_BloodToSoul]] и [[skill:WP_CR_D_WeakPointShot]] — гибкие слоты. При необходимости их можно заменить на [[skill:WP_WA_GR_S_MagicShield]] или [[skill:WP_CR_CR_S_Step]], если в бою важнее выживаемость или мобильность.</p>\n\n<p>[[skill:WP_CR_S_OffHandMaxDmg]] можно заменить на [[skill:WP_WA_GR_S_CurseKillBonus]] в зависимости от времени суток и условий боя.</p>\n\n<p>Если во время боя запас маны часто опускается до 40% и ниже, можно рассмотреть [[skill:WP_CR_S_CriticalAttack]] вместе с мастерством арбалета <strong>«Сосредоточенная стрельба»</strong>. При выполнении этого условия мастерство повышает меткость и шанс критического удара дальнего боя. Такой вариант стоит сравнить с другими пассивными умениями под свою экипировку и продолжительность боя.</p>\n<h3>Приоритет характеристик</h3>\n\n<p><strong>Основные характеристики:</strong> в первую очередь максимально повышаем мудрость и ловкость, затем вкладываемся в восприятие.</p>\n\n<ul>\n  <li><strong>Мудрость</strong> даёт максимальный урон, ману и скорость восстановления умений.</li>\n  <li><strong>Ловкость</strong> повышает максимальный урон и шанс критического удара.</li>\n  <li><strong>Восприятие</strong> полезно для урона и длительности положительных эффектов.</li>\n</ul>\n\n<p><strong>Ключевые характеристики для урона:</strong></p>\n\n<ul>\n  <li>Максимальный урон основного оружия.</li>\n  <li>Повышение урона умений.</li>\n  <li>Повышение урона по типу противника.</li>\n  <li>Шанс мощной атаки, прежде всего магической.</li>\n  <li>Шанс критического удара и критический урон.</li>\n  <li>Скорость восстановления умений и скорость атаки.</li>\n  <li>Длительность положительных эффектов.</li>\n</ul>\n\n<p><strong>Максимальная мана</strong> важна не только как запас ресурса: через пассивное умение [[skill:WP_WA_GR_S_HealEfficiencyByMaxCost]] и соответствующее мастерство она также повышает базовый урон. При выборе между максимальной маной и восстановлением маны предпочитаем максимальную ману, если её хватает на бой.</p>\n\n<h3>Экипировка и артефакты</h3>\n\n<p>В сборке используются Игломёты Бел’Адир и Гримуар Хаоса Каланты, а также выбранные вещи Посмертия и Мудрого старца.</p>\n\n<p>У меня выбран плащ с восстановлением маны, потому что её не хватает для продолжительного боя. Если у вас проблем с маной нет, можно заменить его на плащ с критическими характеристиками для большего урона.</p>\n\n<p>Комплект артефактов «Предвестник Хаоса» даёт характеристики для урона и выживаемости. При подборе свойств обращаем внимание на базовый урон, шанс мощной атаки, критический удар и максимальную ману.</p>\n\n<h3>Полезные материалы</h3>\n\n<ul>\n  <li><a href=\"https://drive.google.com/file/d/1E7G9Lv3vBFcybk_VANh23R59S4iqFAae/view\" target=\"_blank\" rel=\"noopener nofollow ugc\">Гайд Aragon по Фурии и характеристикам</a></li>\n  <li><a href=\"https://www.youtube.com/watch?v=-iiQkz4o5hU\" target=\"_blank\" rel=\"noopener nofollow ugc\">Видео Aragon по сборке</a></li>\n  <li><a href=\"https://www.youtube.com/watch?v=HLN4-_tFcFM\" target=\"_blank\" rel=\"noopener nofollow ugc\">Видео о вариантах игры через проклятия</a></li>\n</ul>","url":"https://tl-build.ru/build/7585"}