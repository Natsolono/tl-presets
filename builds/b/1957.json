ouble_defense",60]]},{"s":"ring2","id":"ring_aa_t1_nomal_003","e":9,"t":[["kCostRegen",4],["kBuffGivenDurationModifier",4],["kSkillPowerAmplification",4]],"ru":[["Attack","AA","melee_critical_attack",60],["Assist","AA","weaken_accuracy",60],["Defense","AA","range_evasion",60]]},{"s":"ring1","id":"ring_aa_t1_nomal_010","e":9,"t":[["kBuffGivenDurationModifier",4],["kSkillPowerAmplification",4],["kHpMax",4]],"ru":[["Attack","A","melee_critical_attack",60],["Defense","A","range_evasion",60],["Assist","A","weaken_accuracy",60]]},{"s":"necklace","id":"necklace_aa_t1_nomal_005","e":9,"t":[["kSkillPowerAmplification",4],["kBuffGivenDurationModifier",4],["kHpMax",4]],"ru":[["Attack","A","melee_accuracy",60],["Defense","A","range_evasion",60],["Assist","A","petrification_accuracy",60]]},{"s":"cloak","id":"cloak_a_t2_set_004","e":9,"t":[["kDebuffTakenDurationModifier",4],["kSkillPowerResistance",4],["kHpMax",4]]}],"act":[["WP_ST_S_WideAreaAttack",null,["SkillSet_WP_ST_S_WideAreaAttack_trait_1","SkillSet_WP_ST_S_WideAreaAttack_trait_2","SkillSet_WP_ST_S_WideAreaAttack_trait_3"]],["WP_ST_S_FireCombo",null,["SkillSet_WP_ST_S_FireCombo_trait_1","SkillSet_WP_ST_S_FireCombo_trait_2"]],["WP_ST_S_WideAreaPowerAttack",null,["SkillSet_WP_ST_S_WideAreaPowerAttack_trait_1"]],["WP_ST_S_WideAreaDebuffAttack",null,["SkillSet_WP_ST_S_WideAreaDebuffAttack_trait_3","SkillSet_WP_ST_S_WideAreaDebuffAttack_trait_4"]],["WP_ST_S_MainAttack",null,["SkillSet_WP_ST_S_MainAttack_trait_1"]],["WP_ST_S_GlobalCoolDownBuff",null,["SkillSet_WP_ST_S_GlobalCoolDownBuff_trait_2"]],["WP_ST_S_IceSpear",null,["SkillSet_WP_ST_S_IceSpear_trait_1","SkillSet_WP_ST_S_IceSpear_trait_3"]],["WP_ST_S_ManaRengeUp",null,[]],["WP_ST_S_PowerAttack",null,[]],["WP_BO_S_MultiShot",null,["SkillSet_WP_BO_S_MultiShot_Trait_3","SkillSet_WP_BO_S_MultiShot_Trait_1"]],["WP_BO_S_StrongShot",null,["SkillSet_WP_BO_S_StrongShot_Trait_1","SkillSet_WP_BO_S_StrongShot_Trait_3"]],["WP_BO_S_AttackMark",null,["SkillSet_WP_BO_S_AttackMark_Trait_2"]]],"pas":[["WP_ST_S_AddProjectile",null,[]],["WP_ST_S_ManaRegenBuff",null,[]],["WP_ST_S_MaxManaUp",null,[]],["WP_ST_S_BurnTargetAddDamage",null,[]],["WP_ST_S_SkillPowerAmplificationBuff",null,[]],["WP_BO_S_DistanceCritical",null,[]],["WP_BO_S_WindBonusProjectile",null,[]],["WP_BO_S_InplaceAttack",null,[]]],"def":["WP_BO_S_CounterMove",null,[]],"art":[],"ms":{},"msl":null,"msw":{},"msc":[],"n":"","calc":"eyJ2IjoyLCJuYW1lIjoi0J_"}],"desc":"<h2>ПВЕ Маг, много урона в хороших руках</h2>\n\nБилд работает идеально в КП где у вас есть 2 хила и возможно второй ДД тоже с луком, но если даже у вас всего 2 человека с луком, то и этого вполне хватает чтобы наносить много урона.\n\nПеред тем как описать ротацию я скажу пару слов о метке. Самое главное что нужно знать о метке это то, что любой ваш крит удар откатывает скилы. А такие скилы как иглы и обстрел делают это быстрее всего. Вся концепция строится вокруг того что, вы используете метку в комбинации с обстрелом и иглами для максимального профита.\n\nИ так сама ротация и пояснения:\n\n1. Перед началом боя жмём Сосредоточенный разум.\n2. Прекаст метеора до начала боя (он у нас с огненным дождём, чтобы вешать стаки поджога на цель сразу 10 штук)\n3. метка по завершению каста метеора (они ещё не начали падать и поджог не висит)\n4. Иглы (всё ещё не достаточно поджога от метеора)\n5. Обстрел (вот теперь с поджогом всё ок, уже есть 10 стаков)\n6. Множественный выстрел х2 \n7. Порвы ветра\n8. Множественный выстрелх1\n9. Цепная молния\n10. Карающий разряд\n11. Порыв ветра\n12. Пылающий разлом (если прокнул жмём два раза - нужен чтобы обновить доты на цели, если у вас не хватает КДРа, то используем его перед молниями)\n13. Огенный шар.\n\nК концу фулл прожима у вас уже откатится и метеор и метка и иглы и обстрел, даже если вас всего 2 лука и всего 2 метки в пати.\n\nНебольшое пояснение про Множественный выстрел и Порыв ветра. Т.к. взяты трейты на шквал то их можно использовать двумя способами - первый это дать им взорваться на 10 стаках самостоятельно, либо взорвать их Порывом Ветра на 8 что даст больше урона. При этом стаки охотничей метки всегда будут 10, они взрываются только Порывом ветра.\nПо моим тестам использование на 8 стаках шквала дает приорост урона на 1.5-2% поэтому если вам сложно можете не заморачиваться этим и жать 3 выстрела и потом только Порыв ветра. Он будет взрывать 10 стаков метки и 2 стака шквала.\n\nБилд ни откуда не копировал всё придумал и проверил сам. \n\n\nПоследнее что хочу добавить. Не стесняйтесь просить хилов дать вам листик (он же милость природы), когда у вас совсем мало МП. Под листик хила можно прожимать ваш реген маны.","url":"https://tl-build.ru/build/1957"}